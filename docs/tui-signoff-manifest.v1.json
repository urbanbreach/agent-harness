{
  "schema_version": "harness-tui-signoff-manifest-v1",
  "description": "Strict-V1 TUI signoff manifest. It names deterministic render owners, PTY provenance stages, and the env-gated native visual gap for release-facing TUI flows; reference-image comparison is not required for this PRD.",
  "native_visual_policy": {
    "lane": "signoff-native",
    "stage": "native_visual_e2e_ignored",
    "required_env": [
      "HARNESS_NATIVE_VISUAL=1",
      "DISPLAY=<display>"
    ],
    "missing_env_status": "documented_gap",
    "roadmap_gap": "docs/roadmap-v1.md native visual checkbox remains unchecked until local signoff-native screenshots exist"
  },
  "flows": [
    {
      "id": "startup",
      "release_class": "normal_prompt_flow",
      "deterministic_tests": [
        "cargo test -p harness-tui --test deterministic_render_test startup_shell_is_compose_first_without_pty"
      ],
      "pty_stages": [
        "scripts/test-lanes.sh signoff-pty :: harness_tui_pty_e2e",
        "scripts/test-lanes.sh signoff-pty :: harness_tui_happy_path_pty"
      ],
      "required_markers": [
        "ctrl+p commands",
        "Type a prompt"
      ]
    },
    {
      "id": "command_palette",
      "release_class": "operator_navigation_flow",
      "deterministic_tests": [
        "cargo test -p harness-tui --test deterministic_render_test command_palette_renders_without_pty",
        "cargo test -p harness-tui command_palette_renders_and_filters"
      ],
      "pty_stages": [
        "scripts/test-lanes.sh signoff-pty :: harness_tui_pty_e2e",
        "scripts/test-lanes.sh signoff-pty :: harness_tui_happy_path_pty"
      ],
      "required_markers": [
        "Commands",
        "New session",
        "Next agent"
      ]
    },
    {
      "id": "session_picker_resume",
      "release_class": "resume_flow",
      "deterministic_tests": [
        "cargo test -p harness-tui --test deterministic_render_test startup_session_history_picker_renders_without_pty",
        "cargo test -p harness-tui session_history_picker_renders_resumable_and_replay_rows"
      ],
      "pty_stages": [
        "scripts/test-lanes.sh signoff-pty :: harness_tui_happy_path_pty"
      ],
      "required_markers": [
        "Continue session",
        "Search",
        "continue ready"
      ]
    },
    {
      "id": "permission_question",
      "release_class": "permission_question_flow",
      "deterministic_tests": [
        "cargo test -p harness-tui --test deterministic_render_test permission_modal_preserves_draft_without_pty",
        "cargo test -p harness-tui --test deterministic_render_test question_permission_prompt_renders_without_pty",
        "cargo test -p harness-tui permission_modal_preempts_palette_and_slash"
      ],
      "pty_stages": [
        "scripts/test-lanes.sh signoff-pty :: harness_tui_happy_path_pty"
      ],
      "required_markers": [
        "Permission required",
        "Allow once",
        "Pick one",
        "enter submit"
      ]
    },
    {
      "id": "provider_tool_failure",
      "release_class": "provider_tool_failure_flow",
      "deterministic_tests": [
        "cargo test -p harness-tui --test deterministic_render_test tool_lifecycle_rows_stay_ordered_without_pty",
        "cargo test -p harness-tui --test deterministic_render_test replay_failure_state_renders_without_pty",
        "cargo test -p harness-tui post_run_failure_handoff_renders_recovery_actions"
      ],
      "pty_stages": [
        "scripts/test-lanes.sh signoff-pty :: harness_tui_happy_path_pty"
      ],
      "required_markers": [
        "snapshot mismatch",
        "run failed",
        "provider stream ended before final message"
      ]
    },
    {
      "id": "diff_review",
      "release_class": "diff_review_flow",
      "deterministic_tests": [
        "cargo test -p harness-tui --test deterministic_render_test tool_lifecycle_rows_stay_ordered_without_pty",
        "cargo test -p harness-tui transcript_apply_patch_surfaces_rename_and_wrapped_inline_diffs",
        "cargo test -p harness-tui diff_hunk_navigation_advances_and_retreats_between_hunks"
      ],
      "pty_stages": [
        "scripts/test-lanes.sh signoff-pty :: harness_tui_happy_path_pty"
      ],
      "required_markers": [
        "Remove diff review surface",
        "artifacts/tool-lifecycle-inline.diff",
        "edit"
      ]
    }
  ],
  "reference_image_policy": "not_required_for_this_prd"
}
