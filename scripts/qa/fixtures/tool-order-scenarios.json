{
  "schema": "tool-order-production-v1",
  "sizes": [[40, 30], [120, 40], [80, 34]],
  "clock": {"epoch_ms": 0, "completion_ms": 430, "settled_age_ms": 600},
  "prompt": "Inspect ordering and lifecycle",
  "tools": {
    "a": {"tool": "read", "kind": "read", "title": "Read alpha.txt", "args": {"path": "alpha.txt"}, "output": "alpha first line\nalpha second line"},
    "b": {"tool": "read", "kind": "read", "title": "Read beta.txt", "args": {"path": "beta.txt"}, "output": "beta first line\nbeta second line"},
    "command-a": {"tool": "bash", "kind": "execute", "title": "Run alpha", "args": {"command": "printf alpha"}, "output": "alpha complete"},
    "command-b": {"tool": "bash", "kind": "execute", "title": "Run beta", "args": {"command": "printf beta"}, "output": "beta complete"},
    "skill-read": {"tool": "read", "kind": "read", "title": "Read .agents/skills/review/SKILL.md", "args": {"path": ".agents/skills/review/SKILL.md"}, "output": "Review the source before changing it."},
    "skill-invoke": {"tool": "skill.load", "kind": "other", "title": "Skill: review", "args": {"name": "review"}, "output": "Skill loaded"},
    "web-a": {"tool": "search.web", "kind": "search", "title": "Web search: terminal rendering", "args": {"query": "terminal rendering"}, "variant": "WebSearch", "output": "Two domains explain terminal rendering.", "sources": ["https://example.com/a", "https://example.com/b", "https://example.org/a"]},
    "web-b": {"tool": "search.web", "kind": "search", "title": "Web search: terminal reflow", "args": {"query": "terminal reflow"}, "variant": "WebSearch", "output": "The same domains explain reflow.", "sources": ["https://example.com/a", "https://example.org/b"]},
    "long-read": {"tool": "read", "kind": "read", "title": "Read long.txt", "args": {"path": "long.txt"}, "output": "line 01\nline 02\nline 03\nline 04\nline 05\nline 06\nline 07\nline 08\nline 09\nline 10\nline 11\nline 12\nline 13\nline 14\nline 15"},
    "generic": {"tool": "fixture.inspect", "kind": "other", "title": "fixture.inspect", "args": {"query": "bounded output"}, "output": "line 01\nline 02\nline 03\nline 04\nline 05\nline 06\nline 07\nline 08\nline 09\nline 10\nline 11\nline 12\nline 13\nline 14\nline 15"},
    "task": {"tool": "task", "kind": "other", "title": "Task", "args": {"description": "Inspect renderer", "prompt": "Inspect renderer", "subagent_type": "general", "run_in_background": true}, "output": "Background task cancelled"}
  },
  "hooks": [
    {"name": "pre-check", "phase": "pre_tool_use", "status": "succeeded", "duration_ms": 12, "output": "checked"},
    {"name": "pre-skip", "phase": "pre_tool_use", "status": "skipped", "duration_ms": 0, "output": null},
    {"name": "post-deny", "phase": "post_tool_use", "status": "blocked", "duration_ms": 18, "output": "blocked by fixture policy"},
    {"name": "post-fail", "phase": "post_tool_use", "status": "failed", "duration_ms": 23, "output": "fixture hook error"}
  ],
  "scenarios": [
    {"name": "thought-preview", "actions": [
      {"op": "reasoning", "text": "**Preparing synthetic preview**"},
      {"op": "snapshot", "name": "one-header", "contains": ["Preparing synthetic preview"], "absent": ["Thought for"]},
      {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": "\n\n**Choosing unique fixture with wrap check**"},
      {"op": "snapshot", "name": "two-headers"},
      {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": "\n\n**Planning synthetic status checks**"},
      {"op": "snapshot", "name": "three-headers", "absent": ["Preparing synthetic preview"]},
      {"op": "advance", "ms": 33}, {"op": "snapshot", "name": "preview-tick-1"},
      {"op": "advance", "ms": 33}, {"op": "snapshot", "name": "preview-tick-2"},
      {"op": "advance", "ms": 264}, {"op": "snapshot", "name": "preview-tick-10"},
      {"op": "reasoning", "text": "\n\n**Rendering the next"},
      {"op": "snapshot", "name": "partial-next-header"},
      {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": " synthetic header**"},
      {"op": "snapshot", "name": "four-headers"}
    ]},
    {"name": "thought-command", "actions": [
      {"op": "reasoning", "text": "**Planning the inspection**"}, {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": "\n\n**Checking the commands**"}, {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": "\n\n**Verifying the result**"},
      {"op": "snapshot", "name": "headers", "contains": ["Thinking", "Checking the commands", "Verifying the result"]},
      {"op": "advance", "ms": 300},
      {"op": "input", "id": "command-a", "index": 0, "delta": "{\"command\":"},
      {"op": "snapshot", "name": "arguments", "contains": ["Thinking", "Verifying the result"], "absent": ["Thought for", "Run printf"]},
      {"op": "advance", "ms": 300}, {"op": "request", "id": "command-a"}, {"op": "start", "id": "command-a"},
      {"op": "snapshot", "name": "tool", "contains": ["Thought for 0.9s", "printf alpha"], "absent": ["Verifying the result"]},
      {"op": "advance", "ms": 400}, {"op": "provider-finish"},
      {"op": "snapshot", "name": "provider-finished", "contains": ["Thought for 0.9s", "printf alpha"]},
      {"op": "advance", "ms": 300}, {"op": "commit"},
      {"op": "snapshot", "name": "committed", "contains": ["Thought for 0.9s", "printf alpha"]},
      {"op": "advance", "ms": 500}, {"op": "finish", "id": "command-a"},
      {"op": "snapshot", "name": "finished", "contains": ["Thought for 0.9s", "printf alpha"]}
    ]},
    {"name": "thought-context", "actions": [
      {"op": "reasoning", "text": "**Planning the inspection**"}, {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": "\n\n**Checking the commands**"}, {"op": "advance", "ms": 150},
      {"op": "reasoning", "text": "\n\n**Verifying the result**"},
      {"op": "snapshot", "name": "headers", "contains": ["Thinking", "Checking the commands", "Verifying the result"]},
      {"op": "advance", "ms": 600}, {"op": "request", "id": "a"}, {"op": "start", "id": "a"},
      {"op": "snapshot", "name": "grouped", "contains": ["Reading 1 file"], "absent": ["Thought for", "Verifying the result"]},
      {"op": "select", "id": "a"}, {"op": "group"},
      {"op": "snapshot", "name": "revealed", "contains": ["Thought for 0.9s", "Read alpha.txt"], "absent": ["Verifying the result"]},
      {"op": "advance", "ms": 400}, {"op": "provider-finish"}, {"op": "advance", "ms": 300}, {"op": "commit"},
      {"op": "snapshot", "name": "committed", "contains": ["Thought for 0.9s", "Read alpha.txt"]},
      {"op": "advance", "ms": 500}, {"op": "finish", "id": "a"},
      {"op": "snapshot", "name": "finished", "contains": ["Thought for 0.9s", "Read alpha.txt"]},
      {"op": "fold-selected"},
      {"op": "snapshot", "name": "thought-open", "contains": ["Thought for 0.9s", "Planning the inspection", "Checking the commands", "Verifying the result"]},
      {"op": "fold-selected"},
      {"op": "snapshot", "name": "thought-closed", "contains": ["Thought for 0.9s"], "absent": ["Verifying the result"]}
    ]},
    {"name": "staggered-motion", "actions": [
      {"op": "request", "id": "command-a"}, {"op": "start", "id": "command-a"},
      {"op": "advance", "ms": 165},
      {"op": "request", "id": "command-b"}, {"op": "start", "id": "command-b"},
      {"op": "snapshot", "name": "second-start", "same_markers": ["printf alpha", "printf beta"]},
      {"op": "advance", "ms": 17},
      {"op": "snapshot", "name": "same-tick", "same_markers": ["printf alpha", "printf beta"]},
      {"op": "advance", "ms": 16},
      {"op": "snapshot", "name": "next-tick", "same_markers": ["printf alpha", "printf beta"]},
      {"op": "advance", "ms": 462},
      {"op": "snapshot", "name": "wave-end", "same_markers": ["printf alpha", "printf beta"]}
    ]},
    {"name": "live-handoff", "actions": [
      {"op": "text", "text": "Inspect first."},
      {"op": "snapshot", "name": "text"},
      {"op": "request", "id": "command-a"},
      {"op": "snapshot", "name": "queued", "order": ["Inspect first.", "printf alpha"]},
      {"op": "start", "id": "command-a"},
      {"op": "advance", "ms": 330},
      {"op": "snapshot", "name": "running", "order": ["Inspect first.", "printf alpha"]},
      {"op": "provider-finish"},
      {"op": "snapshot", "name": "provider-finished", "order": ["Inspect first.", "printf alpha"]},
      {"op": "commit"},
      {"op": "snapshot", "name": "committed", "order": ["Inspect first.", "printf alpha"]},
      {"op": "advance", "ms": 100}, {"op": "finish", "id": "command-a"},
      {"op": "snapshot", "name": "finished", "order": ["Inspect first.", "printf alpha"]},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "settled", "order": ["Inspect first.", "printf alpha"]}
    ]},
    {"name": "interleave", "actions": [
      {"op": "text", "text": "Before alpha. "},
      {"op": "input", "id": "a", "index": 0, "delta": "{\"path\":\"alp"},
      {"op": "text", "text": "Between arguments and request. "},
      {"op": "snapshot", "name": "partial", "audit": ["GAP-01", "U-02"]},
      {"op": "input", "id": "a", "index": 0, "delta": "!!malformed"},
      {"op": "snapshot", "name": "malformed", "audit": ["U-02"]},
      {"op": "input", "id": "b", "index": 1, "delta": "{\"path\":\"beta.txt\"}"},
      {"op": "text", "text": "After beta arguments. "},
      {"op": "barrier"},
      {"op": "request", "id": "a"}, {"op": "start", "id": "a"},
      {"op": "request", "id": "b"}, {"op": "start", "id": "b"},
      {"op": "snapshot", "name": "requested-ab", "audit": ["GAP-01", "U-02"]},
      {"op": "advance", "ms": 430}, {"op": "finish", "id": "b"},
      {"op": "snapshot", "name": "finished-b", "audit": ["GAP-01"]},
      {"op": "finish", "id": "a"}, {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "finished-ba", "audit": ["GAP-01", "GAP-02"]},
      {"op": "replay"},
      {"op": "snapshot", "name": "replayed", "audit": ["GAP-01", "GAP-02"]}
    ]},
    {"name": "completion-order", "actions": [
      {"op": "request", "id": "command-a"}, {"op": "request", "id": "command-b"},
      {"op": "start", "id": "command-a"}, {"op": "start", "id": "command-b"},
      {"op": "snapshot", "name": "requested-ab", "audit": ["GAP-01"]},
      {"op": "advance", "ms": 430}, {"op": "finish", "id": "command-b"},
      {"op": "snapshot", "name": "finished-b", "audit": ["GAP-01"]},
      {"op": "finish", "id": "command-a"}, {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "finished-ba", "audit": ["GAP-01", "GAP-02"]},
      {"op": "replay"},
      {"op": "snapshot", "name": "replayed", "audit": ["GAP-01", "GAP-02"]}
    ]},
    {"name": "read-life", "actions": [
      {"op": "request", "id": "a"},
      {"op": "snapshot", "name": "queued", "audit": ["U-01", "GAP-03"]},
      {"op": "start", "id": "a"}, {"op": "advance", "ms": 330},
      {"op": "snapshot", "name": "running", "audit": ["GAP-03", "U-10"]},
      {"op": "wait", "id": "a"},
      {"op": "snapshot", "name": "waiting", "audit": ["GAP-23"]},
      {"op": "unwait", "id": "a"}, {"op": "advance", "ms": 100},
      {"op": "finish", "id": "a"}, {"op": "open", "id": "a"},
      {"op": "snapshot", "name": "just-finished", "audit": ["U-10", "GAP-03"]},
      {"op": "advance", "ms": 400},
      {"op": "snapshot", "name": "flash-boundary", "audit": ["U-10"]},
      {"op": "advance", "ms": 200},
      {"op": "snapshot", "name": "settled", "audit": ["U-10", "GAP-03", "U-07"]},
      {"op": "select", "id": "a"},
      {"op": "snapshot", "name": "selected", "audit": ["U-07"]}
    ]},
    {"name": "failed", "actions": [
      {"op": "request", "id": "a"}, {"op": "start", "id": "a"},
      {"op": "advance", "ms": 430}, {"op": "finish", "id": "a", "failed": true},
      {"op": "open", "id": "a"}, {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "open", "audit": ["GAP-03", "U-10"]}
    ]},
    {"name": "dense", "actions": [
      {"op": "dense", "count": 12}, {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "closed", "audit": ["GAP-19", "GAP-21"]},
      {"op": "select", "id": "cmd-00"},
      {"op": "snapshot", "name": "selected", "audit": ["GAP-19", "U-07"]},
      {"op": "group"},
      {"op": "snapshot", "name": "expanded", "audit": ["GAP-19"]},
      {"op": "group"},
      {"op": "snapshot", "name": "roundtrip", "audit": ["GAP-19"]}
    ]},
    {"name": "skill", "actions": [
      {"op": "request", "id": "skill-read"}, {"op": "start", "id": "skill-read"}, {"op": "finish", "id": "skill-read"},
      {"op": "request", "id": "skill-invoke"}, {"op": "start", "id": "skill-invoke"}, {"op": "finish", "id": "skill-invoke"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "grouped", "audit": ["GAP-05"]},
      {"op": "select", "id": "skill-read"}, {"op": "group"},
      {"op": "snapshot", "name": "members", "audit": ["GAP-05"]},
      {"op": "details-off"},
      {"op": "snapshot", "name": "details-off", "audit": ["GAP-21"]}
    ]},
    {"name": "sources", "actions": [
      {"op": "request", "id": "web-a"}, {"op": "start", "id": "web-a"}, {"op": "finish", "id": "web-a"},
      {"op": "request", "id": "web-b"}, {"op": "start", "id": "web-b"}, {"op": "finish", "id": "web-b"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "grouped", "audit": ["GAP-20"]},
      {"op": "select", "id": "web-a"}, {"op": "group"},
      {"op": "snapshot", "name": "members", "audit": ["GAP-20"]}
    ]},
    {"name": "hooks", "actions": [
      {"op": "request", "id": "a"}, {"op": "start", "id": "a"}, {"op": "finish", "id": "a", "hooks": true},
      {"op": "request", "id": "b"}, {"op": "start", "id": "b"}, {"op": "finish", "id": "b"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "grouped", "audit": ["GAP-16-HOOK", "GAP-20"]},
      {"op": "open", "id": "a"},
      {"op": "snapshot", "name": "open", "audit": ["GAP-16-HOOK"]}
    ]},
    {"name": "lifecycle", "actions": [
      {"op": "lifecycle", "event": "session_start"},
      {"op": "lifecycle", "event": "user_prompt_submit"},
      {"op": "lifecycle", "event": "session_end"},
      {"op": "snapshot", "name": "rows", "audit": ["GAP-15"]}
    ]},
    {"name": "long", "actions": [
      {"op": "request", "id": "generic"}, {"op": "start", "id": "generic"},
      {"op": "wait", "id": "generic"},
      {"op": "snapshot", "name": "waiting", "audit": ["GAP-23"]},
      {"op": "unwait", "id": "generic"}, {"op": "finish", "id": "generic"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "closed", "audit": ["GAP-24"]},
      {"op": "open", "id": "generic"},
      {"op": "snapshot", "name": "open", "audit": ["GAP-24"]}
    ]},
    {"name": "read-fold", "actions": [
      {"op": "request", "id": "long-read"}, {"op": "start", "id": "long-read"},
      {"op": "advance", "ms": 430}, {"op": "finish", "id": "long-read"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "closed", "audit": ["GAP-24"]},
      {"op": "fold", "id": "long-read"},
      {"op": "snapshot", "name": "first-fold", "audit": ["GAP-24"]},
      {"op": "open", "id": "long-read"},
      {"op": "snapshot", "name": "full", "audit": ["GAP-24"]}
    ]},
    {"name": "waiting-boundary", "actions": [
      {"op": "request", "id": "a"}, {"op": "start", "id": "a"}, {"op": "finish", "id": "a"},
      {"op": "request", "id": "generic"}, {"op": "start", "id": "generic"},
      {"op": "request", "id": "b"}, {"op": "start", "id": "b"}, {"op": "finish", "id": "b"},
      {"op": "wait", "id": "generic"}, {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "waiting", "audit": ["GAP-23"]},
      {"op": "unwait", "id": "generic"}, {"op": "finish", "id": "generic"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "resolved", "audit": ["GAP-23"]}
    ]},
    {"name": "cancel", "actions": [
      {"op": "request", "id": "task"}, {"op": "start", "id": "task"},
      {"op": "snapshot", "name": "started", "audit": ["GAP-22"]},
      {"op": "select", "id": "task"}, {"op": "group"}, {"op": "advance", "ms": 165},
      {"op": "snapshot", "name": "running-members", "audit": ["GAP-22"]}, {"op": "group"},
      {"op": "advance", "ms": 265}, {"op": "cancel-task", "id": "task"},
      {"op": "advance", "ms": 600},
      {"op": "snapshot", "name": "terminal", "audit": ["GAP-22"]},
      {"op": "select", "id": "task"}, {"op": "group"},
      {"op": "snapshot", "name": "members", "audit": ["GAP-22"]}
    ]}
  ]
}
