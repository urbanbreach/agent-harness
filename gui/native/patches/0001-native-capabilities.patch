+    fn input_operation(
+        &mut self,
+        operation: InputOperation,
+        window: &mut Window,
+        cx: &mut Context<crate::renderer::GpuixView>,
+    ) -> Result<(), String> {
+        let state = self.state.as_ref()
+            .ok_or_else(|| "Native input has not rendered".to_string())?;
+        state.update(cx, |state, cx| {
+            match operation {
+                InputOperation::RevealRange { start, end } => {
+                    state.reveal_range = Some(state.range_from_utf16(&(start..end)));
+                    state.follow_cursor = false;
+                    cx.notify();
+                }
+                InputOperation::ScrollTo { x, y } => {
+                    state.scroll_left = x.max(0.0);
+                    state.scroll_top = y.max(0.0);
+                    state.follow_cursor = false;
+                    cx.notify();
+                }
+                InputOperation::SetSelectionListener(callback) => {
+                    state.selection_listener = callback;
+                }
+                InputOperation::SetSelection { start, end } => {
+                    state.marked_range = None;
+                    state.last_edit = None;
+                    state.set_selected_text_range(start.min(end)..start.max(end), window, cx);
+                }
+                InputOperation::ReplaceSelection(text) => {
+                    // Keep each imperative replacement separate from adjacent typing.
+                    state.last_edit = None;
+                    state.marked_range = None;
+                    let range = state.range_to_utf16(&state.selected_range);
+                    state.replace_text_in_range(Some(range), &text, window, cx);
+                    state.last_edit = None;
+                }
+                InputOperation::Command(command) => {
+                    state.last_edit = None;
+                    match command {
+                        InputCommand::Cut => state.cut(&Cut, window, cx),
+                        InputCommand::Copy => state.copy(&Copy, window, cx),
+                        InputCommand::Paste => state.paste(&Paste, window, cx),
+                        InputCommand::SelectAll => state.select_all(&SelectAll, window, cx),
+                        InputCommand::Undo => state.undo(&Undo, window, cx),
+                        InputCommand::Redo => state.redo(&Redo, window, cx),
+                    }
+                    state.last_edit = None;
+                }
+            }
+        });
+        Ok(())
+    }
