{
  "schema_version": "tui-fidelity-scenario-v1",
  "id": "baseline-resize",
  "adapters": ["grok", "harness"],
  "viewport": {"cols": 80, "rows": 24},
  "actions": [{"resize": {"at_tick": 1, "viewport": {"cols": 100, "rows": 30}}}, {"terminal_reply": {"at_tick": 2, "query": "device_attributes", "response": "\u001b[?1;2c"}}],
  "checkpoints": [
    {"name": "rest", "at_tick": 3, "frame": {"capture_id": "baseline-resize-rest", "viewport": {"cols": 100, "rows": 30}, "state": "rest"}},
    {"name": "mid", "at_tick": 4, "frame": {"capture_id": "baseline-resize-mid", "viewport": {"cols": 100, "rows": 30}, "state": "working"}},
    {"name": "settled", "at_tick": 5, "frame": {"capture_id": "baseline-resize-settled", "viewport": {"cols": 100, "rows": 30}, "state": "settled"}}
  ],
  "substitutions": [],
  "expected_exit": {"code": 0},
  "cleanup": {"restore_workspace": true, "preserve_evidence": true, "temporary_paths": ["tmp/tui-fidelity"]},
  "motion_capture": {"families":["ordered_motion","settle_dwell","resize_debounce"],"markers":[{"phase":"startup","boundary":{"before_action":{"ordinal":0}},"observation":"first_changed","repeat_count":1},{"phase":"resize_burst","boundary":{"after_action":{"ordinal":0}},"observation":"each_changed","repeat_count":1},{"phase":"resize_settled","boundary":{"checkpoint":{"name":"rest"}},"observation":"last_changed_before_stable","repeat_count":1},{"phase":"finish_flash","boundary":{"checkpoint":{"name":"mid"}},"observation":"last_changed_before_stable","repeat_count":1},{"phase":"settle_repeat","boundary":{"checkpoint":{"name":"settled"}},"observation":"stable_repeat","repeat_count":3}]}
}
