{
  "$schema": "./config.json",
  "provider": {
    "openai-codex": {
      "type": "openai_compatible",
      "name": "OpenAI Codex Reference Provider Catalog",
      "options": {
        "authProvider": "codex",
        "baseURL": "https://api.openai.com/v1",
        "apiKeyEnv": ["OPENAI_API_KEY"],
        "timeoutMs": 1800000
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT 6 Astra",
          "metadata": { "family": "gpt-astra", "context_window_tokens": 1050000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 288384,
          "max_output_tokens": 128000,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoning_effort": "low", "text_verbosity": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoning_effort": "medium", "text_verbosity": "low" } },
            "high": { "name": "High", "metadata": { "reasoning_effort": "high", "text_verbosity": "low" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "low" } },
            "max": { "name": "Max", "metadata": { "reasoning_effort": "max", "text_verbosity": "low" } }
          }
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "metadata": { "family": "gpt-5", "release_stage": "stable", "context_window_tokens": 272000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "quick implementation" } },
            "medium": { "name": "Medium", "metadata": { "reasoning_effort": "medium", "text_verbosity": "medium", "recommended_for": "balanced implementation" } },
            "high": { "name": "High", "metadata": { "reasoning_effort": "high", "text_verbosity": "medium", "recommended_for": "default build" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "medium", "recommended_for": "hard reasoning" } }
          }
        },
      }
    }
  },
  "model": "openai-codex/gpt-6-astra",
  "agent": {
    "default": {
      "model": "openai-codex/gpt-6-astra",
      "variant": "high"
    }
  },
  "permission": "ask",
  "runtime": {
    "compaction": {
      "enabled": true,
      "split_oversized_turns": false,
      "auto_retry_overflow": true,
      "structured_summary_contract": true,
      "estimated_token_triggers": true,
      "fallback_input_tokens": 32768
    }
  }
}
