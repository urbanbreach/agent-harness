{
  // Background task scheduler defaults
  backgroundTask: {
    defaultConcurrency: 4,
    providerConcurrency: 4,
    modelConcurrency: 2,
    staleTimeoutMs: 30000,
    messageStalenessTimeoutMs: 10000,
  },

  // Provider map (only openai_compatible is supported in Wave 1)
  providers: {
    default: {
      type: "openai_compatible",

      // CLIProxy-style endpoint
      base_url: "http://127.0.0.1:8317/v1",

      // CLIProxy subscriptions typically use a placeholder key (for example sk-zerolimit)
      // Literal or ${ENV_VAR} / ${ENV_VAR:-default} reference
      api_key: "${OPENAI_API_KEY:-sk-zerolimit}",

      // responses | chat_completions | auto
      api_mode: "responses",

      timeout_ms: 60000,

      headers: {
        "X-Client": "harness",
      },

      models: {
        "gpt-5.3-codex": {
          display_name: "GPT-5.3 Codex",
          max_input_tokens: 128000,
          max_output_tokens: 16384,
          variants: {
            deterministic: {
              display_name: "Deterministic",
              max_output_tokens: 4096,
            },
          },
        },
      },
    },
  },

  // Category map used by orchestration profiles
  categories: {
    deep: {
      description: "Default deep execution profile",
      model_ref: "default:gpt-5.3-codex",
      variant: "deterministic",
      temperature: 0.1,
      permissions: {
        edit: "ask",
        shell: "ask",
        network: "deny",
      },
      tools: [
        "fs.read",
        "fs.glob",
        "fs.ls",
        "fs.grep",
        "edit.hashline_scan",
        "edit.hashline_apply",
        "shell.run",
      ],
    },
  },

  permissions: {
    edit: "ask",
    shell: "ask",
    network: "deny",
    shell_allowlist: {
      executables: ["git", "cargo", "ls"],
      cwd_roots: [".", "./crates"],
    },
  },

  // Optional; defaults to .agent-harness/sessions when omitted
  paths: {
    session_dir: ".agent-harness/sessions",
  },

  deterministic: {
    enabled: false,
    seed: 42,
  },

  ui: {
    default_profile: "deep",
    keybindings: {
      submit_prompt: "enter",
      palette: "ctrl+p",
      help: "?",
    },
    max_events_in_memory: 25000,
    max_transcript_chars_in_memory: 200000,
  },

  logging: {
    level: "info",
  },
}
