+#[cfg(not(target_os = "macos"))]
+fn poll_timeout_ms(duration: Option<Duration>) -> libc::c_int {
+    use std::convert::TryFrom;
+
+    duration.map_or(-1, |wait| {
+        // A positive remainder must block, not spin until its deadline.
+        libc::c_int::try_from(wait.as_nanos().div_ceil(1_000_000)).unwrap_or(libc::c_int::MAX)
+    })
+}
+
+#[cfg(all(test, not(target_os = "macos")))]
+mod poll_timeout_tests {
+    use super::{poll_timeout_ms, Duration};
+
+    #[test]
+    fn finite_poll_waits_round_up_without_becoming_infinite() {
+        for (duration, expected) in [
+            (None, -1),
+            (Some(Duration::ZERO), 0),
+            (Some(Duration::from_nanos(1)), 1),
+            (Some(Duration::from_nanos(999_999)), 1),
+            (Some(Duration::from_millis(1)), 1),
+            (Some(Duration::from_nanos(1_000_001)), 2),
+            (Some(Duration::from_millis(50)), 50),
+            (Some(Duration::from_millis(2_147_483_647)), libc::c_int::MAX),
+            (Some(Duration::from_millis(2_147_483_648)), libc::c_int::MAX),
+            (Some(Duration::MAX), libc::c_int::MAX),
+        ] {
+            assert_eq!(poll_timeout_ms(duration), expected, "{duration:?}");
+        }
+    }
+}
