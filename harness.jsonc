{
  "$schema": "./configs/config.json",
  "provider": {
    "default": {
      "type": "openai_compatible",
      "name": "CLIProxyAPI (OpenAI)",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "sk-zerolimit",
        "timeoutMs": 1800000
      },
      "models": {
        "gpt-5.3-codex": { "name": "GPT 5.3 Codex", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.5": { "name": "GPT 5.5", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.4": { "name": "GPT 5.4", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.4-mini": { "name": "GPT 5.4 Mini", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.2": { "name": "GPT 5.2", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.1-codex-max": { "name": "GPT 5.1 Codex Max", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.1-codex": { "name": "GPT 5.1 Codex", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.1-codex-mini": { "name": "GPT 5.1 Codex Mini", "limit": { "context": 272000, "input": 272000, "output": 128000 } },
        "gpt-5.1": { "name": "GPT 5.1", "limit": { "context": 272000, "input": 272000, "output": 128000 } }
      }
    }
  },
  "model": "default/gpt-5.4",
  "small_model": "default/gpt-5.4-mini",
  "agent": {
    "build": { "model": "default/gpt-5.4-mini" },
    "plan": { "model": "default/gpt-5.5" }
  },
  "default_agent": "build",
  "permission": {
    "*": "ask",
    "shell_allowlist": {
      "executables": ["bash", "git", "cargo", "ls", "rg"],
      "cwd_roots": ["."]
    }
  },
  "mcp": {
    "gh_grep": {
      "transport": "http",
      "endpoint": "https://mcp.grep.app"
    },
    "docs-rs": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@nuskey8/docs-rs-mcp@latest"]
    },
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["/home/ubere/.cargo/bin/cargo-mcp", "serve"],
      "enabled": false
    },
    "pty-mcp": {
      "transport": "stdio",
      "command": ["bunx", "-y", "pty-mcp"]
    },
    "playwright": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "svelte": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@sveltejs/mcp"],
      "enabled": false
    },
    "tauri": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": false
    }
  }
}
