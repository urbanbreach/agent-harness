    "umans-ai-coding-plan": {
      "type": "openai_compatible",
      "name": "Umans AI Coding Plan",
      "options": {
        "apiMode": "chat_completions",
        "baseURL": "https://api.code.umans.ai/v1",
        "apiKeyEnv": ["UMANS_AI_CODING_PLAN_API_KEY"],
        "timeoutMs": 1800000,
      },
      "models": {
        "umans-coder": {
          "name": "Coder",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "umans-flash": {
          "name": "Flash",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "umans-glm-5.2": {
          "name": "GLM 5.2",
          "limit": { "context": 405504, "input": 405504, "output": 131072 },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "variants": {
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
            "max": {
              "name": "Max",
              "metadata": { "reasoningEffort": "max" },
            },
          },
        },
        "umans-kimi-k2.7": {
          "name": "Kimi K2.7 Code",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "options": {
            "thinking": { "type": "enabled", "budgetTokens": 32000 },
          },
        },
        "umans-qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
    "electron-hub-devpass": {
      "type": "openai_compatible",
      "name": "Electron Hub DevPass",
      "options": {
        "apiMode": "chat_completions",
        "baseURL": "https://api.electronhub.ai/v1",
        "apiKeyEnv": ["ELECTRONHUB_API_KEY"],
        "timeoutMs": 1800000,
      },
      "models": {
        "gpt-oss-120b:dev": {
          "name": "GPT OSS 120B (DevPass)",
          "limit": { "context": 128000, "output": 32768 },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "options": { "reasoningEffort": "high" },
          "variants": {
