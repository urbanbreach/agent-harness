{
  "reference_git": "b1fc8113948b518835c2a39ece49553cffe9b30c",
  "source_files": [
    "packages/reference/src/permission/index.ts",
    "packages/reference/src/agent/agent.ts",
    "packages/reference/src/agent/subagent-permissions.ts"
  ],
  "evaluate_default_action": "ask",
  "disabled_semantics": "last rule matching tool permission has pattern '*' and action deny",
  "edit_tools": ["edit", "write", "apply_patch"],
  "agents": {
    "build": {
      "notes": "defaults + question allow + plan_enter allow + user",
      "catch_all_deny_tools": []
    },
    "plan": {
      "notes": "edit * deny + plan path allow; task.general deny; plan_exit allow",
      "edit_visible": true,
      "task_denied_agents": ["general"]
    },
    "explore": {
      "permission_overlay": {
        "*": "deny",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "read": "allow"
      },
      "must_hide": ["edit", "write", "apply_patch", "task", "todowrite"],
      "must_show": ["read", "glob", "grep", "list", "bash", "webfetch", "websearch"]
    },
    "general": {
      "todowrite": "deny",
      "must_show_if_in_toolset": ["edit", "bash", "read"]
    },
    "title": { "permission_overlay": { "*": "deny" } },
    "summary": { "permission_overlay": { "*": "deny" } },
    "compaction": { "permission_overlay": { "*": "deny" } }
  },
  "bash_cases": [
    {
      "id": "git_status",
      "command": "git status -sb",
      "expect": "allow_or_ask_not_hard_fail"
    },
    {
      "id": "dev_null_redirect",
      "command": "git log --oneline -5 2>/dev/null",
      "expect": "not_path_escape_hard_fail"
    },
    {
      "id": "find_glob",
      "command": "find crates -name '*.rs' | wc -l",
      "expect": "not_glob_hard_fail"
    }
  ]
}
