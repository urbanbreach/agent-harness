+pub(super) fn styled_runs(
+    text: &str,
+    styles: &[Run],
+    base_font: gpui::Font,
+    base_color: gpui::Hsla,
+) -> Vec<TextRun> {
+    let base = TextRun {
+        len: 0,
+        font: base_font,
+        color: base_color,
+        background_color: None,
+        underline: None,
+        strikethrough: None,
+    };
+    let mut prepared = Vec::with_capacity(styles.len());
+    let mut events = Vec::with_capacity(styles.len() * 2 + 2);
+    for (index, (run, range)) in styles.iter().zip(byte_ranges(text, styles)).enumerate() {
+        let mut value = base.clone();
+        let foreground = color(run.color.as_deref());
+        let background = color(run.background.as_deref());
+        if let Some(color) = foreground {
+            value.color = color;
+        }
+        if let Some(family) = &run.font_family {
+            value.font.family = family.clone().into();
+        }
+        if let Some(weight) = &run.font_weight {
+            value.font.weight = crate::renderer::parse_font_weight(weight);
+        }
+        if let Some(italic) = run.italic {
+            value.font.style = if italic {
+                gpui::FontStyle::Italic
+            } else {
+                gpui::FontStyle::Normal
+            };
+        }
+        value.underline = run
+            .underline
+            .as_ref()
+            .map(|decoration| gpui::UnderlineStyle {
+                color: color(decoration.color.as_deref()),
+                thickness: gpui::px(decoration.thickness.unwrap_or(1.0)),
+                wavy: decoration.wavy.unwrap_or(false),
+            });
+        value.strikethrough =
+            run.strikethrough
+                .as_ref()
+                .map(|decoration| gpui::StrikethroughStyle {
+                    color: color(decoration.color.as_deref()),
+                    thickness: gpui::px(decoration.thickness.unwrap_or(1.0)),
+                });
+        value.background_color = background;
+        let properties = [
+            foreground.is_some(),
+            run.font_family.is_some(),
+            run.font_weight.is_some(),
+            run.italic.is_some(),
+            run.underline.is_some(),
+            run.strikethrough.is_some(),
+            background.is_some(),
+        ];
+        prepared.push((value, properties));
+        // Keep even empty/reversed range boundaries, but never activate their styles.
+        events.extend([
+            (range.start, index, range.start < range.end),
+            (range.end, index, false),
+        ]);
+    }
+    events.extend([(0, styles.len(), false), (text.len(), styles.len(), false)]);
+    events.sort_unstable();
+    let mut active: [BTreeSet<usize>; 7] = std::array::from_fn(|_| BTreeSet::new());
+    let mut result = Vec::with_capacity(events.len());
+    let mut cursor = 0;
+    while cursor < events.len() {
+        let start = events[cursor].0;
+        while cursor < events.len() && events[cursor].0 == start {
+            let (_, index, entering) = events[cursor];
+            if let Some((_, properties)) = prepared.get(index) {
+                for (set, present) in active.iter_mut().zip(properties) {
+                    if *present {
+                        if entering {
+                            set.insert(index);
+                        } else {
+                            set.remove(&index);
+                        }
+                    }
+                }
+            }
+            cursor += 1;
+        }
+        let Some(&(end, _, _)) = events.get(cursor) else {
+            break;
+        };
+        let mut value = base.clone();
+        value.len = end - start;
+        // Each property independently inherits from the last applicable input run.
+        for (property, set) in active.iter().enumerate() {
+            let Some(index) = set.last() else {
+                continue;
+            };
+            let source = &prepared[*index].0;
+            match property {
+                0 => value.color = source.color,
+                1 => value.font.family = source.font.family.clone(),
+                2 => value.font.weight = source.font.weight,
+                3 => value.font.style = source.font.style,
+                4 => value.underline = source.underline,
+                5 => value.strikethrough = source.strikethrough,
+                6 => value.background_color = source.background_color,
+                _ => unreachable!(),
+            }
+        }
+        result.push(value);
+    }
+    result
+}
