+    options: &WindowOptions,
+    mut bounds: gpui::Bounds<gpui::Pixels>,
+    cx: &gpui::App,
+) -> gpui::Bounds<gpui::Pixels> {
+    let (Some(x), Some(y)) = (options.x, options.y) else { return bounds; };
+    if !x.is_finite() || !y.is_finite() || options.layer_shell.is_some() { return bounds; }
+    let displays = cx.displays();
+    let saved_display = options.display_id.as_deref().and_then(|id| {
+        displays.iter().find(|display| display.uuid().ok().is_some_and(|uuid| uuid.to_string() == id)).cloned()
+    });
