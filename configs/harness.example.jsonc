{
  // Shipped primary-agent workflow:
  //   1. start in `build` by default
  //   2. switch to `plan` when you want a read-only planning pass
  //   3. let `plan.exit` hand off back into `build`
  providers: {
    default: {
      type: "openai_compatible",
      // Blessed default path: local CLIProxy-compatible bridge.
      // This shipped config intentionally pairs the explicit `sk-zerolimit`
      // fallback with the loopback proxy endpoint so first-run docs and live
      // signoff lanes stay aligned without pointing at a real remote API.
      base_url: "http://127.0.0.1:8317/v1",
      api_key: "${OPENAI_API_KEY:-sk-zerolimit}",
      api_mode: "auto",
      timeout_ms: 60000,
      models: {
        "gpt-5.4": {
          display_name: "GPT-5.4",
          metadata: {
            family: "gpt-5",
            release_stage: "stable",
            context_window_tokens: 400000,
            supports_tool_calls: true,
            supports_reasoning_summaries: true,
          },
          max_input_tokens: 400000,
          max_output_tokens: 32768,
        },
        "gpt-5.4-mini": {
          display_name: "GPT-5.4 Mini",
          metadata: {
            family: "gpt-5",
            release_stage: "stable",
            context_window_tokens: 128000,
            supports_tool_calls: true,
            supports_reasoning_summaries: true,
          },
          max_input_tokens: 128000,
          max_output_tokens: 16384,
          variants: {
            deterministic: {
              display_name: "Deterministic",
              max_output_tokens: 4096,
              metadata: {
                description: "Low-variance evidence collection profile.",
                reasoning_effort: "minimal",
                text_verbosity: "low",
                recommended_for: "tool_audit",
              },
            },
            low: {
              display_name: "Low",
              max_output_tokens: 4096,
              metadata: {
                description: "Low-reasoning live-provider parity signoff profile.",
                reasoning_effort: "low",
                text_verbosity: "low",
                recommended_for: "live_proxy",
              },
            },
            high: {
              display_name: "High",
              max_output_tokens: 4096,
              metadata: {
                description: "High-reasoning interactive profile for visible thinking traces.",
                reasoning_effort: "high",
                text_verbosity: "low",
                recommended_for: "interactive_live",
              },
            },
          },
        },
      },
    },
  },
  agent: {
    // Primary shipped agents: `build` by default, `plan` for approval-gated planning.
    plan: {
      description: "Planning lane: investigate read-only, produce an explicit plan, and hand off to build after approval.",
      system_prompt: "Stay in planning mode until the user approves implementation. Remain read-only: do not edit files, run shell commands, or delegate implementation. Investigate first with the available read-only tools, distinguish confirmed facts from open questions and assumptions, and ask targeted questions when a missing fact would change the plan. Produce an implementation-ready plan with scope boundaries, likely files, ordered steps, risks, open questions, assumptions that still need confirmation, and concrete verification steps. If approval is missing or the situation is still unclear, keep planning instead of acting. Call plan.exit only after the user explicitly approves implementation so the harness can hand off to build.",
      model_ref: "default:gpt-5.4-mini",
      // Optional profile-level override: set `reasoning_effort` here when you
      // want the same reasoning preset to stay active after switching models.
      variant: "low",
      tool_surface: "native",
      plan_mode: true,
      exit_target_profile: "build",
      max_iters: 16,
      permissions: {
        edit: "deny",
        shell: "deny",
        network: "allow",
        question: "allow",
        task: "deny",
        webfetch: "allow",
        websearch: "allow",
        codesearch: "allow",
        lsp: "allow",
      },
      tools: [
        "todo.write",
        "todo.read",
        "user.question",
        "skill.load",
        "search.web",
        "web.fetch",
        "search.code",
        "code.lsp",
        "fs.read",
        "fs.glob",
        "fs.grep",
        "fs.ls",
        "tool.batch",
        "plan.exit",
      ],
    },
    build: {
      description: "Implementation lane: execute an approved plan with scoped edits and verification.",
      system_prompt: "Implement only the approved plan after the explicit plan.exit handoff. Start by restating the approved scope, keep edits small and reversible, and verify the narrowest useful change before widening. Prefer reversible batches that keep progress legible. If the approved plan leaves a material gap or reality no longer matches the plan, stop and ask instead of inventing new scope. Use subagents only when they materially help, and finish with concrete evidence, changed files, what was not tested, and remaining risks.",
      model_ref: "default:gpt-5.4-mini",
      variant: "high",
      tool_surface: "native",
      max_iters: 24,
      permissions: {
        edit: "allow",
        shell: "allow",
        network: "allow",
        question: "allow",
        task: "allow",
        webfetch: "allow",
        websearch: "allow",
        codesearch: "allow",
        lsp: "allow",
      },
      tools: [
        "todo.write",
        "todo.read",
        "user.question",
        "skill.load",
        "search.web",
        "web.fetch",
        "search.code",
        "code.lsp",
        "fs.read",
        "fs.glob",
        "fs.grep",
        "fs.ls",
        "fs.write",
        "shell.run",
        "edit.hashline_apply",
        "edit.hashline_scan",
        "tool.batch",
        "agent.spawn",
      ],
    },
    // Bounded delegated lanes: target these through `agent.spawn.profile`
    // or compat `task.subagent_type` instead of inventing ad hoc workers.
    researcher: {
      description: "Read-only delegated research lane for scoped evidence gathering.",
      system_prompt: "You are the Researcher subagent for delegated harness work. Stay read-only, evidence-first, and tightly scoped to the delegated slice. Gather only the context needed to answer the parent agent's request, keep notes concise, and favor file references plus concrete findings over long narration. Do not edit files, do not run shell commands, do not broaden scope, and do not claim the parent task is complete. Finish with findings, referenced files or tools, verification-ready evidence, and any blocker the parent must resolve.",
      model_ref: "default:gpt-5.4-mini",
      variant: "low",
      tool_surface: "native",
      max_iters: 12,
      permissions: {
        edit: "deny",
        shell: "deny",
        network: "allow",
        question: "deny",
        task: "deny",
        webfetch: "allow",
        websearch: "allow",
        codesearch: "allow",
        lsp: "allow",
      },
      tools: [
        "search.web",
        "web.fetch",
        "search.code",
        "code.lsp",
        "fs.read",
        "fs.glob",
        "fs.grep",
        "fs.ls",
        "tool.batch",
      ],
    },
    implementer: {
      description: "Focused delegated implementation lane for approved file-scoped edits.",
      system_prompt: "You are the Implementer subagent for delegated harness work. Execute only the approved slice already handed to you, prefer the smallest coherent diff, and keep every change legible for the parent agent to review. Edit only the files needed for this slice, run the narrowest verification that proves it, and report concrete changed files plus evidence. Do not widen scope, do not introduce speculative redesign, do not ask the user new questions, and do not claim the parent task is complete. If the slice needs broader authority or a bigger design choice, stop and hand the blocker back to the parent agent.",
      model_ref: "default:gpt-5.4-mini",
      variant: "high",
      tool_surface: "native",
      max_iters: 16,
      permissions: {
        edit: "allow",
        shell: "allow",
        network: "deny",
        question: "deny",
        task: "deny",
        webfetch: "deny",
        websearch: "deny",
        codesearch: "allow",
        lsp: "allow",
      },
      tools: [
        "search.code",
        "code.lsp",
        "fs.read",
        "fs.glob",
        "fs.grep",
        "fs.ls",
        "fs.write",
        "shell.run",
        "edit.hashline_apply",
        "edit.hashline_scan",
        "tool.batch",
      ],
    },
    reviewer: {
      description: "Read-only delegated review lane for targeted verification and risk checks.",
      system_prompt: "You are the Reviewer subagent for delegated harness work. Verify the delegated slice without editing code: inspect the relevant files, run only the checks that matter, and surface concrete correctness, maintainability, or risk findings. Keep the review bounded to the requested slice, cite the files, commands, or outputs that support each conclusion, and clearly separate confirmed issues from possible follow-ups. Do not make edits, do not broaden scope, and do not claim the parent task is complete. Finish with a concise pass/fail-style verdict, evidence, and any blocker or recommendation for the parent agent.",
      model_ref: "default:gpt-5.4-mini",
      variant: "low",
      tool_surface: "native",
      max_iters: 12,
      permissions: {
        edit: "deny",
        shell: "allow",
        network: "deny",
        question: "deny",
        task: "deny",
        webfetch: "deny",
        websearch: "deny",
        codesearch: "allow",
        lsp: "allow",
      },
      tools: [
        "search.code",
        "code.lsp",
        "fs.read",
        "fs.glob",
        "fs.grep",
        "fs.ls",
        "shell.run",
        "tool.batch",
      ],
    },
    // Secondary shipped signoff lane: evidence-first verification of the surface.
    tool_audit: {
      description: "Evidence-first signoff profile for validating the shipped tool surface.",
      system_prompt: "Collect signoff evidence across skills, question flow, hooks evidence, LSP evidence, subagent execution, variants, model metadata, and HARNESS_QUESTION_ANSWERS handling before declaring the config healthy.",
      model_ref: "default:gpt-5.4-mini",
      variant: "deterministic",
      tool_surface: "native",
      max_iters: 20,
      tool_failure_mode: "continue_as_tool_message",
      tools: [
        "skill.load",
        "user.question",
        "code.lsp",
        "agent.spawn",
        "tool.batch",
        "tool.invalid",
        "todo.write",
        "todo.read",
      ],
    },
    // Secondary shipped compat lane: parity/regression coverage for compat ids.
    deep_compat: {
      description: "Compat-surface regression profile for parity coverage.",
      model_ref: "default:gpt-5.4-mini",
      tool_surface: "compat",
      max_iters: 20,
      tools: [
        "read",
        "list",
        "glob",
        "grep",
        "bash",
        "write",
        "apply_patch",
        "webfetch",
        "todowrite",
        "todoread",
        "task",
        "batch",
        "skill",
        "question",
        "websearch",
        "codesearch",
        "lsp",
        "invalid",
      ],
    },
  },
  default_agent: "build",
  permissions: {
    defaults: {
      edit: "ask",
      shell: "ask",
      network: "ask",
      question: "ask",
      task: "ask",
      webfetch: "ask",
      websearch: "ask",
      codesearch: "ask",
      lsp: "ask",
    },
    shell_allowlist: {
      executables: ["bash", "git", "cargo", "ls", "rg"],
      cwd_roots: ["."],
    },
  },
  runtime: {
    background_tasks: {
      default_concurrency: 2,
      provider_concurrency: 2,
      model_concurrency: 2,
      stale_timeout_ms: 30000,
      message_staleness_timeout_ms: 10000,
    },
    prompt: {
      wait_timeout_ms: 30000,
      compaction: {
        enabled: true,
        max_history_chars: 12000,
        preserve_recent_turns: 2,
      },
    },
    session_dir: "./.harness/sessions",
    deterministic: {
      enabled: false,
      seed: 42,
    },
  },
  integrations: {
    remote_search: {
      endpoint: "https://mcp.exa.ai/mcp",
    },
    mcp: {
      servers: {
        gh_grep: {
          type: "remote",
          url: "https://mcp.grep.app",
          enabled: true,
        },
        "docs-rs": {
          type: "local",
          command: ["bunx", "-y", "@nuskey8/docs-rs-mcp@latest"],
          enabled: true,
        },
        "cargo-mcp": {
          type: "local",
          command: ["/home/ubere/.cargo/bin/cargo-mcp", "serve"],
          enabled: false,
        },
        "pty-mcp": {
          type: "local",
          command: ["bunx", "-y", "pty-mcp"],
          enabled: true,
        },
        playwright: {
          type: "local",
          command: ["bunx", "-y", "@playwright/mcp@latest"],
          enabled: false,
        },
        svelte: {
          type: "local",
          command: ["bunx", "-y", "@sveltejs/mcp"],
          enabled: false,
        },
        tauri: {
          type: "local",
          command: ["bunx", "-y", "@hypothesi/tauri-mcp-server"],
          enabled: false,
        },
      },
    },
  },
  hooks: {
    lifecycle: [
      {
        event: "run_started",
        command: ["bash", "-lc", "printf 'run started\n'"],
        timeout_ms: 4000,
        critical: false,
        env: {
          HARNESS_HOOK_SOURCE: "example-config",
        },
      },
      {
        event: "tool_call_finished",
        command: ["bash", "-lc", "printf 'tool finished\n'"],
        timeout_ms: 4000,
        critical: false,
      },
    ],
  },
  skills: {
    project_roots: [".opencode/skills", ".claude/skills", ".agents/skills"],
    global_roots: ["~/.config/opencode/skills", "~/.claude/skills", "~/.agents/skills"],
    walk_to_git_root: true,
    permissions: {
      "*": "allow",
      "internal-*": "deny",
      "experimental-*": "ask",
    },
  },
  lsp: {
    disabled: false,
    servers: {
      rust: {
        disabled: false,
        command: ["rust-analyzer"],
        extensions: [".rs"],
        env: {
          RUST_LOG: "warn",
        },
        initialization: {
          cargo: {
            allFeatures: true,
          },
        },
      },
    },
  },
  ui: {
    parity: {
      variant_cycle_enabled: true,
      child_session_navigation_enabled: true,
      keybindings: {
        variant_cycle: "tab",
        session_child_first: "ctrl+]",
        session_child_cycle: "]",
        session_child_cycle_reverse: "[",
        session_parent: "ctrl+[",
      },
    },
  },
  logging: {
    level: "info",
  },
}
