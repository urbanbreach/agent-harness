+        if display_missing { return None; }
+        displays.iter().find(|display| display.bounds().contains(&gpui::point(gpui::px(x as f32), gpui::px(y as f32)))).cloned()
+    }).or_else(|| cx.primary_display());
+    let Some(display) = display else { return bounds; };
+    let visible = display.visible_bounds();
+    let width = f32::from(bounds.size.width);
+    let height = f32::from(bounds.size.height);
+    let left = f32::from(visible.left());
+    let top = f32::from(visible.top());
+    let right = f32::from(visible.right());
+    let bottom = f32::from(visible.bottom());
+    let (x, y) = if display_missing {
+        (left + (f32::from(visible.size.width) - width) / 2.0, top + (f32::from(visible.size.height) - height) / 2.0)
+    } else { (x as f32, y as f32) };
+    let min_x = left + width.min(160.0) - width;
+    let max_x = (right - width.min(160.0)).max(min_x);
+    bounds.origin = gpui::point(gpui::px(x.clamp(min_x, max_x)), gpui::px(y.clamp(top, (bottom - 22.0).max(top))));
