{
  "schema": "tool-runtime-input-v1",
  "sizes": [[40, 32], [80, 32], [120, 40]],
  "command": "printf tool_rows",
  "description": "Inspect scrollable tool output",
  "prompt": "Scroll tools",
  "line_count": 160,
  "start_offset": 60,
  "keys": ["k", "j", "u", "d"],
