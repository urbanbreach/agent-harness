{
  "$schema": "./configs/config.json",
  "provider": {
    "default": {
      "type": "openai_compatible",
      "name": "CLIProxyAPI (OpenAI)",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "sk-zerolimit",
        "timeoutMs": 1800000
      },
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "metadata": {
            "family": "gpt-5",
            "release_stage": "stable",
            "context_window_tokens": 272000,
            "supports_tool_calls": true,
            "supports_reasoning_summaries": true
          },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "metadata": {
            "family": "gpt-5",
            "release_stage": "stable",
            "context_window_tokens": 272000,
            "supports_tool_calls": true,
            "supports_reasoning_summaries": true
          },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "deterministic": {
              "name": "Deterministic",
              "max_output_tokens": 4096,
              "metadata": {
                "description": "Low-variance evidence collection profile.",
                "reasoning_effort": "minimal",
                "text_verbosity": "low",
                "recommended_for": "tool_audit"
              }
            },
            "low": {
              "name": "Low",
              "max_output_tokens": 4096,
              "metadata": {
                "description": "Low-reasoning signoff profile.",
                "reasoning_effort": "low",
                "text_verbosity": "low",
                "recommended_for": "plan"
              }
            },
            "high": {
              "name": "High",
              "max_output_tokens": 4096,
              "metadata": {
                "description": "High-reasoning interactive profile.",
                "reasoning_effort": "high",
                "text_verbosity": "low",
                "recommended_for": "build"
              }
            }
          }
        }
      }
    }
  },
  "model": "default/gpt-5.4",
  "small_model": "default/gpt-5.4-mini",
  "agent": {
    "build": {
      "model": "default/gpt-5.4-mini",
      "variant": "high"
    },
    "plan": {
      "use_small_model": true,
      "variant": "low"
    },
    "tool_audit": {
      "use_small_model": true,
      "variant": "deterministic"
    }
  },
  "default_agent": "build",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "question": "ask",
    "task": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "lsp": "ask",
    "shell_allowlist": {
      "executables": ["bash", "git", "cargo", "ls", "rg"],
      "cwd_roots": ["."]
    }
  },
  "mcp": {
    "gh_grep": {
      "transport": "http",
      "endpoint": "https://mcp.grep.app",
      "enabled": true
    },
    "docs-rs": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@nuskey8/docs-rs-mcp@latest"],
      "enabled": true
    },
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["/home/ubere/.cargo/bin/cargo-mcp", "serve"],
      "enabled": false
    },
    "pty-mcp": {
      "transport": "stdio",
      "command": ["bunx", "-y", "pty-mcp"],
      "enabled": true
    },
    "playwright": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "svelte": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@sveltejs/mcp"],
      "enabled": false
    },
    "tauri": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": false
    }
  }
}
