+fn register_pointer_events(
+    window: &mut Window,
+    layout: &TextLayout,
+    id: u64,
+    text: &SharedString,
+    callback: &Option<crate::renderer::EventCallback>,
+    events: &std::collections::HashSet<String>,
+) {
+    macro_rules! listen {
+        ($kind:literal, $ty:ty, $event:ident, $payload:ident, $filter:expr, $extra:block) => {
+            if events.contains($kind) {
+                let (layout, text, callback) = (layout.clone(), text.clone(), callback.clone());
+                window.on_mouse_event(move |$event: &$ty, phase, _, _| {
+                    if phase != gpui::DispatchPhase::Bubble || !layout.bounds().contains(&$event.position) || !($filter) { return; }
+                    crate::renderer::emit_event_full(&callback, id, $kind, |$payload| {
+                        $payload.char_index = crate::element_tree::pointer_index(layout.index_for_position($event.position).ok().map(|byte| utf16_offset(&text, byte) as f64));
+                        $payload.x = Some(f32::from($event.position.x) as f64);
+                        $payload.y = Some(f32::from($event.position.y) as f64);
+                        $payload.modifiers = Some($event.modifiers.into());
+                        $extra
+                    });
+                });
+            }
+        };
+    }
+    listen!("click", gpui::MouseUpEvent, event, payload, event.button == gpui::MouseButton::Left, {
+        payload.button = Some(0);
+        payload.click_count = Some(event.click_count as u32);
+        payload.is_right_click = Some(false);
+    });
+    listen!("mouseDown", gpui::MouseDownEvent, event, payload, true, {
+        payload.button = Some(crate::renderer::mouse_button_to_u32(event.button));
+        payload.click_count = Some(event.click_count as u32);
+    });
+    listen!("mouseMove", gpui::MouseMoveEvent, event, payload, true, {
+        payload.pressed_button = event.pressed_button.map(crate::renderer::mouse_button_to_u32);
+    });
+}
