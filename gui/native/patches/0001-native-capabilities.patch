+/// GPUI converts platform Entered/Pending into typed drag moves and refreshes
+/// after Exited/Ended. Retain hovered paths across frames to pair leave events.
+pub(crate) fn wire_file_drag_events(
+    mut element: gpui::Stateful<gpui::Div>,
+    id: u64,
+    events: &std::collections::HashSet<String>,
+    callback: Option<EventCallback>,
+) -> gpui::Stateful<gpui::Div> {
+    use gpui::prelude::*;
+    let enter = events.contains("fileDragEnter");
+    let leave = events.contains("fileDragLeave");
+    let moves = events.contains("fileDragMove");
+    if !enter && !leave && !moves { return element; }
+    let retained = Rc::new(RefCell::new(None::<gpui::Entity<Option<Vec<String>>>>));
+    let state_for_paint = retained.clone();
+    let callback_for_paint = callback.clone();
+    element = element.child(gpui::canvas(
+        move |_, window, cx| window.use_keyed_state(
+            gpui::SharedString::from(format!("__gpuix_file_drag_{id}")), cx, |_, _| None::<Vec<String>>
+        ),
+        move |bounds, state, window, cx| {
+            *state_for_paint.borrow_mut() = Some(state.clone());
+            if state.read(cx).is_some() && (!cx.has_active_drag() || !bounds.contains(&window.mouse_position())) {
+                let paths = state.update(cx, |paths, _| paths.take());
+                if leave {
+                    emit_file_drag(&callback_for_paint, id, "fileDragLeave", window.mouse_position(), paths, false);
+                }
+            }
+        },
+    ).absolute().size_full());
+    element.on_drag_move::<gpui::ExternalPaths>(move |event, _window, cx| {
+        let Some(state) = retained.borrow().clone() else { return; };
+        let inside = event.bounds.contains(&event.event.position);
+        let was_inside = state.read(cx).is_some();
+        if inside && (!was_inside || moves) {
+            let paths = file_drop_paths(event.drag(cx));
+            if !was_inside {
+                state.update(cx, |value, _| *value = paths.clone());
+                if enter { emit_file_drag(&callback, id, "fileDragEnter", event.event.position, paths.clone(), true); }
+            }
+            if moves { emit_file_drag(&callback, id, "fileDragMove", event.event.position, paths, true); }
+        } else if !inside && was_inside {
+            let paths = state.update(cx, |value, _| value.take());
+            if leave { emit_file_drag(&callback, id, "fileDragLeave", event.event.position, paths, false); }
+        }
+    })
+}
+
+fn emit_file_drag(
+    callback: &Option<EventCallback>, id: u64, kind: &str,
+    position: gpui::Point<gpui::Pixels>, paths: Option<Vec<String>>, hovered: bool,
+) {
+    emit_event_full(callback, id, kind, |payload| {
+        let (x, y) = point_to_xy(position);
+        payload.x = Some(x);
+        payload.y = Some(y);
+        payload.paths = paths;
+        payload.hovered = Some(hovered);
+    });
+}
