{
  "$schema": "./config.json",
  "provider": {
    "openai-codex": {
      "type": "openai_compatible",
      "name": "OpenAI Codex Reference Provider Catalog",
      "options": {
        "authProvider": "codex",
        "baseURL": "https://api.openai.com/v1",
        "apiKeyEnv": ["OPENAI_API_KEY"],
        "timeoutMs": 1800000
      },
      "models": {
        "gpt-5.3-codex": {
          "name": "GPT 5.3 Codex",
          "metadata": { "family": "gpt-5", "release_stage": "stable", "context_window_tokens": 272000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "none": { "name": "None", "metadata": { "reasoning_effort": "none", "text_verbosity": "low", "recommended_for": "fast edits" } },
            "low": { "name": "Low", "metadata": { "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "routine coding" } },
            "medium": { "name": "Medium", "metadata": { "reasoning_effort": "medium", "text_verbosity": "medium", "recommended_for": "balanced coding" } },
            "high": { "name": "High", "metadata": { "reasoning_effort": "high", "text_verbosity": "medium", "recommended_for": "deep coding" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "medium", "recommended_for": "hard coding" } }
          }
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "metadata": { "family": "gpt-5", "release_stage": "stable", "context_window_tokens": 272000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "quick implementation" } },
            "medium": { "name": "Medium", "metadata": { "reasoning_effort": "medium", "text_verbosity": "medium", "recommended_for": "balanced implementation" } },
            "high": { "name": "High", "metadata": { "reasoning_effort": "high", "text_verbosity": "medium", "recommended_for": "default build" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "medium", "recommended_for": "hard reasoning" } }
          }
        },
        "gpt-5.4": {
          "name": "GPT 5.4 (272k)",
          "metadata": { "family": "gpt-5", "release_stage": "stable", "context_window_tokens": 272000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "routine coding" } },
            "medium": { "name": "Medium", "metadata": { "reasoning_effort": "medium", "text_verbosity": "medium", "recommended_for": "balanced coding" } },
            "high": { "name": "High", "metadata": { "reasoning_effort": "high", "text_verbosity": "medium", "recommended_for": "deep coding" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "medium", "recommended_for": "hard reasoning" } },
            "1m-low": { "name": "1M Low", "context_window_tokens": 922000, "max_input_tokens": 922000, "metadata": { "description": "Extended context preset for local reference only.", "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "large-context scans" } },
            "1m-medium": { "name": "1M Medium", "context_window_tokens": 922000, "max_input_tokens": 922000, "metadata": { "description": "Extended context preset for local reference only.", "reasoning_effort": "medium", "text_verbosity": "medium", "recommended_for": "large-context implementation" } },
            "1m-high": { "name": "1M High", "context_window_tokens": 922000, "max_input_tokens": 922000, "metadata": { "description": "Extended context preset for local reference only.", "reasoning_effort": "high", "text_verbosity": "medium", "recommended_for": "large-context deep work" } },
            "1m-xhigh": { "name": "1M XHigh", "context_window_tokens": 922000, "max_input_tokens": 922000, "metadata": { "description": "Extended context preset for local reference only.", "reasoning_effort": "xhigh", "text_verbosity": "medium", "recommended_for": "large-context hard reasoning" } }
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini",
          "metadata": { "family": "gpt-5", "release_stage": "stable", "context_window_tokens": 272000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "low": { "name": "Low", "metadata": { "description": "Low-reasoning lightweight profile.", "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "lightweight runs" } },
            "medium": { "name": "Medium", "metadata": { "description": "Medium-reasoning lightweight profile.", "reasoning_effort": "medium", "text_verbosity": "low", "recommended_for": "balanced lightweight runs" } },
            "high": { "name": "High", "metadata": { "description": "High-reasoning interactive profile.", "reasoning_effort": "high", "text_verbosity": "low", "recommended_for": "build" } },
            "xhigh": { "name": "XHigh", "metadata": { "description": "Extra-high-reasoning interactive profile.", "reasoning_effort": "xhigh", "text_verbosity": "low", "recommended_for": "hard reasoning" } }
          }
        },
        "gpt-5.2": {
          "name": "GPT 5.2",
          "metadata": { "family": "gpt-5", "release_stage": "stable", "context_window_tokens": 272000, "supports_tool_calls": true, "supports_reasoning_summaries": true },
          "max_input_tokens": 272000,
          "max_output_tokens": 128000,
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoning_effort": "low", "text_verbosity": "low", "recommended_for": "routine coding" } },
            "medium": { "name": "Medium", "metadata": { "reasoning_effort": "medium", "text_verbosity": "medium", "recommended_for": "balanced coding" } },
            "high": { "name": "High", "metadata": { "reasoning_effort": "high", "text_verbosity": "medium", "recommended_for": "deep coding" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "medium", "recommended_for": "hard reasoning" } },
            "max": { "name": "Max", "metadata": { "reasoning_effort": "xhigh", "text_verbosity": "high", "recommended_for": "maximum reasoning" } }
          }
        }
      }
    }
  },
  "model": "openai-codex/gpt-5.4",
  "agent": {
    "build": {
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "high"
    }
  },
  "default_agent": "build",
  "permission": "ask",
  "runtime": {
    "compaction": {
      "model_backed": false,
      "model": "openai-codex/gpt-5.4-mini",
      "split_oversized_turns": false,
      "auto_retry_overflow": true,
      "structured_summary_contract": true,
      "estimated_token_triggers": true,
      "fallback_input_tokens": 32768
    }
  }
}
