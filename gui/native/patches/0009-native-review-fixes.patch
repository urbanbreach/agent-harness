+        let mut tree = rich_text_tree();
+        tree.set_event_listener(2, "click".to_string(), true);
+        let tree = Arc::new(Mutex::new(tree));
+        let events = Arc::new(EventMutex::new(Vec::new()));
+        let (view, cx) = mount(cx, tree.clone(), events.clone());
+        let position = gpui::point(gpui::px(6.), gpui::px(12.));
