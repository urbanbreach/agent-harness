        },
        "gpt-5.1": {
          "name": "GPT 5.1",
          "limit": { "context": 272000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "options": { "serviceTier": "priority" },
          "variants": {
            "none": {
              "name": "None",
              "metadata": { "reasoningEffort": "none" },
            },
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": {
              "name": "Medium",
              "metadata": { "reasoningEffort": "medium" },
            },
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
          },
        },
      },
    },
    "default": {
      "type": "openai_compatible",
      "name": "CLIProxyAPI (OpenAI)",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "sk-zerolimit",
        "timeoutMs": 1800000,
      },
      "models": {
        "gpt-5.3-codex": { "name": "GPT 5.3 Codex" },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": {
              "name": "Medium",
              "metadata": { "reasoningEffort": "medium" },
            },
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
            "xhigh": {
              "name": "XHigh",
              "metadata": { "reasoningEffort": "xhigh" },
            },
          },
        },
        "gpt-5.4": {
          "name": "GPT 5.4 (272k)",
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": {
              "name": "Medium",
              "metadata": { "reasoningEffort": "medium" },
            },
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
            "xhigh": {
              "name": "XHigh",
              "metadata": { "reasoningEffort": "xhigh" },
            },
          },
        },
        "gpt-5.4-1m": { "name": "GPT 5.4 (1M)" },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini",
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": {
              "name": "Medium",
              "metadata": { "reasoningEffort": "medium" },
            },
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
            "xhigh": {
              "name": "XHigh",
              "metadata": { "reasoningEffort": "xhigh" },
            },
          },
        },
        "gpt-5.2": { "name": "GPT 5.2" },
        "gpt-5.1-codex-max": { "name": "GPT 5.1 Codex Max" },
        "gpt-5.1-codex": { "name": "GPT 5.1 Codex" },
        "gpt-5.1-codex-mini": { "name": "GPT 5.1 Codex Mini" },
        "gpt-5.1": { "name": "GPT 5.1" },
      },
    },
    "umans-ai-coding-plan": {
      "type": "openai_compatible",
      "name": "Umans AI Coding Plan",
      "options": {
        "apiMode": "chat_completions",
        "baseURL": "https://api.code.umans.ai/v1",
        "apiKeyEnv": ["UMANS_AI_CODING_PLAN_API_KEY"],
        "timeoutMs": 1800000,
      },
      "models": {
        "umans-coder": {
          "name": "Coder",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "umans-flash": {
          "name": "Flash",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "umans-glm-5.2": {
          "name": "GLM 5.2",
          "limit": { "context": 405504, "input": 405504, "output": 131072 },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "variants": {
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
            "max": {
              "name": "Max",
              "metadata": { "reasoningEffort": "max" },
            },
          },
        },
        "umans-kimi-k2.7": {
          "name": "Kimi K2.7 Code",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "options": {
            "thinking": { "type": "enabled", "budgetTokens": 32000 },
          },
        },
        "umans-qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "limit": { "context": 262144, "input": 262144, "output": 262144 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },

  // Default primary model and smaller model used by internal runtime operations.
  "model": "umans-ai-coding-plan/umans-kimi-k2.7",
  "small_model": "umans-ai-coding-plan/umans-flash",

  // One generic parent plus named subagents for bounded task delegation.
  "agent": {
    "default": {
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "general": {
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "explore": {
      "model": "umans-ai-coding-plan/umans-flash",
    },
    "librarian": {
      "model": "umans-ai-coding-plan/umans-flash",
    },
  },

  // Default tool permission policy for this workspace.
  "permission": {
    "*": "ask",
    "shell_allowlist": {
      "executables": ["bash", "git", "cargo", "ls", "rg"],
      "cwd_roots": ["."],
    },
  },

  // MCP servers available to configured agents/tools. Disabled entries stay as
  // documented options but do not launch.
  "mcp": {
    "gh_grep": {
      "transport": "http",
      "endpoint": "https://mcp.grep.app",
    },
    "docs-rs": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@nuskey8/docs-rs-mcp@latest"],
    },
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["/home/ubere/.cargo/bin/cargo-mcp", "serve"],
      "enabled": false,
    },
    "playwright": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": false,
    },
    "svelte": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@sveltejs/mcp"],
      "enabled": false,
    },
    "tauri": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": false,
    },
  },
}
