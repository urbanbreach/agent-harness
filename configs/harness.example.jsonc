{
  // Background task scheduler defaults
  backgroundTask: {
    defaultConcurrency: 4,
    providerConcurrency: 4,
    modelConcurrency: 2,
    staleTimeoutMs: 30000,
    messageStalenessTimeoutMs: 10000,
  },

  // Provider map (only openai_compatible is supported in Wave 1)
  providers: {
    default: {
      type: "openai_compatible",

      // CLIProxy-style endpoint
      base_url: "http://127.0.0.1:8317/v1",

      // Literal key, required ${VAR}, or optional ${VAR:-default}
      // Use fallback here so `config validate` works without local secrets.
      api_key: "${OPENAI_API_KEY:-DUMMY}",

      // API mode for OpenAI-compatible providers:
      // responses | chat_completions | auto
      api_mode: "chat_completions",

      timeout_ms: 60000,

      headers: {
        "X-Client": "harness",
      },

      models: {
        "gpt-4o-mini": {
          display_name: "GPT-4o mini",
          max_input_tokens: 128000,
          max_output_tokens: 16384,
          variants: {
            deterministic: {
              display_name: "Deterministic",
              max_output_tokens: 4096,
            },
          },
        },
      },
    },
  },

  // Category map used by orchestration profiles
  categories: {
    deep: {
      description: "Default deep execution profile",
      model_ref: "default:gpt-4o-mini",
      variant: "deterministic",
      temperature: 0.1,
      permissions: {
        edit: "ask",
        shell: "ask",
        network: "deny",
      },
      tools: ["read", "edit.hashline_apply", "shell.run"],
    },
  },

  permissions: {
    edit: "ask",
    shell: "ask",
    network: "deny",
    shell_allowlist: {
      executables: ["git", "cargo", "ls"],
      cwd_roots: [".", "./crates"],
    },
  },

  // Optional; defaults to .agent-harness/sessions when omitted
  paths: {
    session_dir: ".agent-harness/sessions",
  },

  deterministic: {
    enabled: false,
    seed: 42,
  },

  // Optional UI defaults for TUI behavior and layout
  ui: {
    theme: "opencode_dark", // mono | opencode_dark | default
    layout: {
      activity_width_pct: 32,
      inspector_width_pct: 38,
      input_height_rows: 6,
    },
    default_profile: "deep",
    max_events_in_memory: 2000,
    max_transcript_chars_in_memory: 2000000,
    disable_animations: false,
  },

  // Optional logging behavior
  logging: {
    level: "info",
    file: ".agent-harness/harness.log",
    redact: true,
  },

  // Optional key overrides for fixed actions
  keybindings: {
    quit: "q",
    focus_next: "tab",
    focus_prev: "shift+tab",
    palette: "ctrl+p",
    help: "?",
    toggle_follow: "f",
    submit_prompt: "enter",
    clear_prompt: "ctrl+u",
    scroll_up: "k",
    scroll_down: "j",
    tab_run: "1",
    tab_events: "2",
    tab_diff: "3",
  },
}
