[
  {
    "name": "before-expanded",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--profile",
      "ci",
      "-p",
      "harness-tui",
      "--all-features",
      "-E",
      "test(focus_shortcuts_follow_visible_shell_and_preserve_replay) | test(help_preempts_palette_and_close_restores_original_focus) | binary(rewrite_reference_test)"
    ],
    "env": {
      "HARNESS_TUI_REFERENCE_FRAMES": "/tmp/tui-focus/before-frames"
    },
    "exit_code": 0
  },
  {
    "name": "candidate-expanded",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--profile",
      "ci",
      "-p",
      "harness-tui",
      "--all-features",
      "-E",
      "test(focus_shortcuts_follow_visible_shell_and_preserve_replay) | test(help_preempts_palette_and_close_restores_original_focus) | binary(rewrite_reference_test)"
    ],
    "env": {
      "HARNESS_TUI_REFERENCE_FRAMES": "/tmp/tui-focus/candidate-frames"
    },
    "exit_code": 0
  },
  {
