+        assert_eq!(app.focus, Focus::Terminal);
+        open_help(&mut app);
+        assert_eq!(
+            app.focus,
+            if replay {
+                Focus::Terminal
+            } else {
+                Focus::Details
+            }
+        );
+        app.handle_key(key(KeyCode::Esc));
+        assert_eq!(app.review_surface(), None);
+        assert_eq!(app.focus, Focus::Terminal);
+    }
