{
  "$schema": "./config.json",

  // Provider and model catalog. Most projects only need one provider and one
  // default model here; keep larger catalogs in provider-catalog.reference.jsonc.
  "provider": {
    "openai-codex": {
      "type": "openai_compatible",
      "name": "OpenAI Codex",
      "options": {
        "authProvider": "codex",
        "baseURL": "https://api.openai.com/v1",
        "apiKeyEnv": ["OPENAI_API_KEY"],
        "timeoutMs": 1800000,
        // Prompt-cache routing posture for OpenAI-compatible providers:
        // "short" (default) sends a stable per-session prompt_cache_key,
        // "long" adds provider-supported long retention only for direct OpenAI,
        // and "none" omits cache-affinity fields.
        "cacheRetention": "short"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "metadata": { "supportsToolCalls": true },
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoningEffort": "medium" } },
            "high": { "name": "High", "metadata": { "reasoningEffort": "high" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoningEffort": "xhigh" } }
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini",
          "metadata": { "supportsToolCalls": true },
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoningEffort": "medium" } },
            "high": { "name": "High", "metadata": { "reasoningEffort": "high" } }
          }
        }
      }
    }
  },

  // Active default model. Use provider/model, optionally provider/model/variant.
  "model": "openai-codex/gpt-5.4-mini",

  // Category scale, adapted to the Codex OAuth-backed GPT-family starter catalog.
  // Runtime profile resolution selects the primary target; fallback targets are
  // validated/catalog metadata until explicit automatic model retry is shipped.
  // Larger provider catalogs can point these same profile names at Gemini,
  // Claude, Kimi, or other provider-specific targets without changing agents.
  "model_profile": {
    "category-visual-engineering": {
      "model": "openai-codex/gpt-5.5",
      "variant": "high",
      "fallback": [{ "model": "openai-codex/gpt-5.4-mini", "variant": "high" }]
    },
    "category-artistry": {
      "model": "openai-codex/gpt-5.5",
      "variant": "high",
      "fallback": [{ "model": "openai-codex/gpt-5.4-mini", "variant": "high" }]
    },
    "category-ultrabrain": {
      "model": "openai-codex/gpt-5.5",
      "variant": "xhigh",
      "fallback": [{ "model": "openai-codex/gpt-5.4-mini", "variant": "high" }]
    },
    "category-deep": {
      // Matches the Deep lane as broad autonomous work, not Ultrabrain-level reasoning.
      "model": "openai-codex/gpt-5.5",
      "variant": "medium",
      "fallback": [{ "model": "openai-codex/gpt-5.4-mini", "variant": "high" }]
    },
    "category-quick": {
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "low",
      "fallback": [{ "model": "openai-codex/gpt-5.5", "variant": "low" }]
    },
    "category-unspecified-low": {
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "medium",
      "fallback": [{ "model": "openai-codex/gpt-5.5", "variant": "medium" }]
    },
    "category-unspecified-high": {
      "model": "openai-codex/gpt-5.5",
      "variant": "high",
      "fallback": [{ "model": "openai-codex/gpt-5.4-mini", "variant": "high" }]
    },
    "category-writing": {
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "medium",
      "fallback": [{ "model": "openai-codex/gpt-5.5", "variant": "medium" }]
    }
  },

  // Built-in agents are listed so they are easy to discover and toggle.
  // Set enable:false (or enabled:false) to remove one from the runtime.
  // Add model, prompt, tools, or permission here only when overriding defaults.
  "agent": {
    "build": {
      "enable": true,
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "high",
    },
    // Stable read-only planning lane: Plan may inspect the workspace and write
    // only .agent-harness/plans/<run>.md, then uses plan_exit to ask before
    // continuing implementation in Build.
    "plan": {
      "enable": true,
      "model": "openai-codex/gpt-5.5",
      "variant": "xhigh",
    },
    "general": {
      "enable": true,
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "medium",
    },
    "explore": {
      "enable": true,
      "model": "openai-codex/gpt-5.4-mini",
      "variant": "low",
    },
    // Task category routes. These are subagents used by
    // task(category=...) and intentionally deny recursive task delegation by
    // default.
    "visual-engineering": {
      "enable": true,
      "model": "category-visual-engineering",
    },
    "artistry": {
      "enable": true,
      "model": "category-artistry",
    },
    "ultrabrain": {
      "enable": true,
      "model": "category-ultrabrain",
    },
    "deep": {
      "enable": true,
      "model": "category-deep",
    },
    "quick": {
      "enable": true,
      "model": "category-quick",
    },
    "unspecified-low": {
      "enable": true,
      "model": "category-unspecified-low",
    },
    "unspecified-high": {
      "enable": true,
      "model": "category-unspecified-high",
    },
    "writing": {
      "enable": true,
      "model": "category-writing",
    },
    "title": {
      "enable": true,
      "hidden": true,
    },
    "summary": {
      "enable": true,
      "hidden": true,
    },
    "compaction": {
      "enable": true,
      "hidden": true,
    }
  },

  "default_agent": "build",

  // One scalar applies to all supported tool permissions; switch to an object
  // when a project needs per-tool rules.
  "permission": "ask",

  // Optional auto-formatters applied after successful file edits.
  // Use `formatter: false` to disable; omit the key to enable all 26 built-in
  // formatters by default. Entries are keyed by formatter name, not extension.
  // Matching formatters run in built-in registry declaration order.
  "formatter": {
    "enabled": true,
    "experimentalOxfmt": false,
    "rustfmt": {},
    "biome": { "disabled": true },
    "prettier": { "environment": { "BUN_BE_BUN": "1" } }
  },

  // Optional MCP servers. Disabled entries stay documented but do not launch.
  "mcp": {
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["cargo-mcp", "serve"],
      "enabled": false
    }
  }
}
