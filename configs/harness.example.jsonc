{
  "$schema": "https://github.com/urbanbreach/agent-harness/releases/latest/download/harness.schema.json",

  // Optional personal defaults for ~/.harness/harness.jsonc.
  // First sign-in creates a minimal config if none exists; it never overwrites it.
  // No config is needed to start: run harness and use /login.
  // Choose a connected provider/model only if you want to pin the default.
  // "model": "anthropic/claude-sonnet-4-6",

  // Ask before changing files. "*" keeps every other tool on its built-in
  // default; without it, tools with no rule of their own (todowrite, skill,
  // session tools) ask on every call.
  "permission": {
    "*": "allow",
    "edit": "ask"
  },

  // Custom OpenAI-compatible endpoint. Defining any provider makes the catalog
  // curated: only configured providers plus signed-in Codex, GitHub Copilot and
  // Claude subscription are included. Without provider entries, stored
  // credentials and provider API key environment variables are discovered
  // automatically.
  // "provider": {
  //   "local": {
  //     "type": "openai_compatible",
  //     "options": {
  //       "baseURL": "http://localhost:1234/v1",
  //       "apiKeyEnv": ["LOCAL_API_KEY"]
  //     },
  //     "models": { "my-model": {} }
  //   }
  // },
}
