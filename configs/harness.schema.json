{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HarnessConfig",
  "type": "object",
  "required": [
    "integrations",
    "permissions",
    "providers",
    "runtime"
  ],
  "properties": {
    "$schema": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ProfileConfig"
      }
    },
    "agents": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ProfileConfig"
      }
    },
    "default_agent": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "hooks": {
      "default": {
        "lifecycle": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/HooksConfig"
        }
      ]
    },
    "integrations": {
      "$ref": "#/definitions/IntegrationsConfig"
    },
    "logging": {
      "default": {
        "file": null,
        "level": "info"
      },
      "allOf": [
        {
          "$ref": "#/definitions/LoggingConfig"
        }
      ]
    },
    "lsp": {
      "default": {
        "disabled": false,
        "servers": {}
      },
      "allOf": [
        {
          "$ref": "#/definitions/LspConfig"
        }
      ]
    },
    "permissions": {
      "$ref": "#/definitions/PermissionsConfig"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ProviderConfig"
      }
    },
    "runtime": {
      "$ref": "#/definitions/RuntimeConfig"
    },
    "skills": {
      "default": {
        "global_roots": [
          "~/.config/opencode/skills",
          "~/.claude/skills",
          "~/.agents/skills"
        ],
        "permissions": {
          "*": "allow",
          "experimental-*": "ask",
          "internal-*": "deny"
        },
        "project_roots": [
          ".opencode/skills",
          ".claude/skills",
          ".agents/skills"
        ],
        "walk_to_git_root": true
      },
      "allOf": [
        {
          "$ref": "#/definitions/SkillsConfig"
        }
      ]
    },
    "ui": {
      "default": {
        "default_profile": null,
        "keybindings": {},
        "maxEventsInMemory": 25000,
        "maxTranscriptCharsInMemory": 200000,
        "parity": {
          "child_session_navigation_enabled": true,
          "keybindings": {
            "session_child_cycle": null,
            "session_child_cycle_reverse": null,
            "session_child_first": null,
            "session_parent": null,
            "variant_cycle": null
          },
          "variant_cycle_enabled": true
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/UiConfig"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BackgroundTaskSettings": {
      "type": "object",
      "required": [
        "defaultConcurrency",
        "messageStalenessTimeoutMs",
        "modelConcurrency",
        "providerConcurrency",
        "staleTimeoutMs"
      ],
      "properties": {
        "defaultConcurrency": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "messageStalenessTimeoutMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "modelConcurrency": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "providerConcurrency": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "staleTimeoutMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "DeterministicConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "seed": {
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HookLifecycleEvent": {
      "type": "string",
      "enum": [
        "run_started",
        "run_finished",
        "run_failed",
        "agent_turn_started",
        "agent_turn_finished",
        "tool_call_started",
        "tool_call_finished",
        "provider_request_started",
        "provider_request_finished",
        "subagent_spawned",
        "subagent_finished",
        "permission_requested",
        "permission_resolved"
      ]
    },
    "HooksConfig": {
      "type": "object",
      "properties": {
        "lifecycle": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/LifecycleHookConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "IntegrationsConfig": {
      "description": "Current public integration settings.\n\nAgent Harness exposes the native remote search transport used by the built-in `web_search` and `code_search` tools, plus configured MCP servers.",
      "type": "object",
      "properties": {
        "mcp": {
          "default": {
            "servers": {}
          },
          "allOf": [
            {
              "$ref": "#/definitions/McpConfig"
            }
          ]
        },
        "remote_search": {
          "description": "Configuration for the currently supported built-in external integrations.\n\nAgent Harness exposes the native remote search transport used by the built-in `web_search` and `code_search` tools, plus configured MCP servers.",
          "default": {
            "auth_token": null,
            "endpoint": "https://mcp.exa.ai/mcp",
            "max_retries": 1,
            "require_auth": false,
            "retry_backoff_ms": 250,
            "timeout_secs": 30
          },
          "allOf": [
            {
              "$ref": "#/definitions/RemoteSearchConfig"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LifecycleHookConfig": {
      "type": "object",
      "required": [
        "command",
        "event"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical": {
          "default": false,
          "type": "boolean"
        },
        "cwd": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "event": {
          "$ref": "#/definitions/HookLifecycleEvent"
        },
        "id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_ms": {
          "default": 5000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "LoggingConfig": {
      "type": "object",
      "properties": {
        "file": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "default": "info",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LspConfig": {
      "type": "object",
      "properties": {
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "servers": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/LspServerConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "LspServerConfig": {
      "type": "object",
      "properties": {
        "command": {
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "env": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extensions": {
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "initialization": {
          "default": null
        }
      },
      "additionalProperties": false
    },
    "McpConfig": {
      "type": "object",
      "properties": {
        "servers": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/McpServerConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "McpServerConfig": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "command",
            "transport"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "env": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout_secs": {
              "default": 30,
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "transport": {
              "type": "string",
              "enum": [
                "stdio"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "endpoint",
            "transport"
          ],
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "headers": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout_secs": {
              "default": 30,
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "transport": {
              "type": "string",
              "enum": [
                "http"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ModelConfig": {
      "type": "object",
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "max_input_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "max_output_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "metadata": {
          "default": {
            "context_window_tokens": null,
            "family": null,
            "release_stage": null,
            "supports_reasoning_summaries": null,
            "supports_tool_calls": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/ModelMetadataConfig"
            }
          ]
        },
        "variants": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ModelVariantConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "ModelMetadataConfig": {
      "type": "object",
      "properties": {
        "context_window_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "family": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "release_stage": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ModelReleaseStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "supports_reasoning_summaries": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_tool_calls": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelReleaseStage": {
      "type": "string",
      "enum": [
        "stable",
        "preview",
        "deprecated"
      ]
    },
    "ModelVariantConfig": {
      "type": "object",
      "properties": {
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "display_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "max_input_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "max_output_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "metadata": {
          "default": {
            "description": null,
            "reasoning_effort": null,
            "recommended_for": null,
            "text_verbosity": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/ModelVariantMetadataConfig"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelVariantMetadataConfig": {
      "type": "object",
      "properties": {
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ModelVariantReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_for": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "text_verbosity": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ModelVariantTextVerbosity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelVariantReasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "ModelVariantTextVerbosity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "OpenAiApiMode": {
      "type": "string",
      "enum": [
        "responses",
        "chat_completions",
        "auto"
      ]
    },
    "PermissionDefaultsConfig": {
      "type": "object",
      "required": [
        "edit",
        "network",
        "shell"
      ],
      "properties": {
        "codesearch": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "edit": {
          "$ref": "#/definitions/PermissionMode"
        },
        "lsp": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "network": {
          "$ref": "#/definitions/PermissionMode"
        },
        "question": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "shell": {
          "$ref": "#/definitions/PermissionMode"
        },
        "task": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "webfetch": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "websearch": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PermissionMode": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "PermissionsConfig": {
      "type": "object",
      "required": [
        "defaults"
      ],
      "properties": {
        "defaults": {
          "$ref": "#/definitions/PermissionDefaultsConfig"
        },
        "shell_allowlist": {
          "default": {
            "cwd_roots": [],
            "executables": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/ShellAllowlist"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ProfileConfig": {
      "type": "object",
      "required": [
        "description",
        "model_ref"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "exit_target_profile": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "max_iters": {
          "description": "Per-profile multi-turn budget enforced directly by the runtime. There is no separate hardcoded runtime iteration cap beyond this setting.",
          "default": 12,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "model_ref": {
          "type": "string"
        },
        "permissions": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ProfilePermissions"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_mode": {
          "default": false,
          "type": "boolean"
        },
        "reasoning_effort": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ModelVariantReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "system_prompt": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "temperature": {
          "description": "When unset, the runtime omits `temperature` from provider requests so the provider default applies.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "tool_failure_mode": {
          "default": "fail_turn",
          "allOf": [
            {
              "$ref": "#/definitions/ToolFailureMode"
            }
          ]
        },
        "tool_surface": {
          "default": "native",
          "allOf": [
            {
              "$ref": "#/definitions/ToolSurface"
            }
          ]
        },
        "tools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variant": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ProfilePermissions": {
      "type": "object",
      "properties": {
        "codesearch": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "edit": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "lsp": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "network": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "shell": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "webfetch": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "websearch": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PromptRuntimeConfig": {
      "type": "object",
      "properties": {
        "wait_timeout_ms": {
          "default": 30000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ProviderConfig": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "api_key",
            "base_url",
            "type"
          ],
          "properties": {
            "api_key": {
              "type": "string"
            },
            "api_mode": {
              "default": "auto",
              "allOf": [
                {
                  "$ref": "#/definitions/OpenAiApiMode"
                }
              ]
            },
            "base_url": {
              "type": "string"
            },
            "headers": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "models": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/ModelConfig"
              }
            },
            "timeout_ms": {
              "default": 60000,
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "openai_compatible"
              ]
            }
          }
        }
      ]
    },
    "RemoteSearchConfig": {
      "description": "Settings for the built-in remote search bridge.\n\nThe current runtime expects an Exa-compatible MCP endpoint for native `web_search` and `code_search` requests.",
      "type": "object",
      "properties": {
        "auth_token": {
          "description": "Optional bearer token for the remote search endpoint.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "description": "Endpoint used by the built-in remote search bridge.\n\nThe current runtime expects an Exa-compatible MCP endpoint for native `web_search` and `code_search` requests.",
          "default": "https://mcp.exa.ai/mcp",
          "type": "string"
        },
        "max_retries": {
          "description": "Maximum retry attempts for retryable remote search failures.",
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "require_auth": {
          "description": "Require an auth token before the native search tools make requests.",
