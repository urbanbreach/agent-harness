diff --git i/packages/native/src/input_api.rs w/packages/native/src/input_api.rs
new file mode 100644
index 0000000..338e338
--- /dev/null
+++ w/packages/native/src/input_api.rs
@@ -0,0 +1,80 @@
+//! Imperative native-editor operations use JavaScript UTF-16 offsets.
+
+use std::sync::Arc;
+
+use napi::threadsafe_function::{ThreadsafeFunction, ThreadsafeFunctionCallMode};
+use napi::{Error, Result};
+use napi_derive::napi;
+
+use crate::custom_elements::input::{InputCommand, InputOperation};
+use crate::element_tree::EventPayload;
+use crate::renderer::EventCallback;
+use crate::renderer::GpuixRenderer;
+
+fn index(value: f64, name: &str) -> Result<usize> {
+    if !value.is_finite() || value < 0.0 || value.fract() != 0.0 || value > 9_007_199_254_740_991.0 {
+        return Err(Error::from_reason(format!("{name} must be a nonnegative safe integer")));
+    }
+    Ok(value as usize)
+}
+
+#[napi]
+impl GpuixRenderer {
+    /// Subscribe directly, bypassing framework-level document-selection routing.
+    /// Passing null removes the listener; unmounting also releases it.
+    #[napi]
+    pub fn set_input_selection_listener(
+        &self,
+        id: f64,
+        callback: Option<ThreadsafeFunction<EventPayload>>,
+    ) -> Result<()> {
+        let callback = callback.map(|callback| {
+            Arc::new(move |payload: EventPayload| {
+                callback.call(Ok(payload), ThreadsafeFunctionCallMode::NonBlocking);
+            }) as EventCallback
+        });
+        self.apply_input_operation(id, InputOperation::SetSelectionListener(callback))
+    }
+
+    /// Set a mounted input's selection using UTF-16 code-unit offsets.
+    #[napi]
+    pub fn input_set_selection(&self, id: f64, start: f64, end: f64) -> Result<()> {
+        self.apply_input_operation(id, InputOperation::SetSelection {
+            start: index(start, "start")?,
+            end: index(end, "end")?,
+        })
+    }
+
+    /// Replace the current selection as one independent undoable edit.
+    #[napi]
+    pub fn input_replace_selection(&self, id: f64, text: String) -> Result<()> {
+        self.apply_input_operation(id, InputOperation::ReplaceSelection(text))
+    }
+
+    /// Execute an editing command on the addressed input, regardless of focus.
+    #[napi]
+    pub fn input_command(&self, id: f64, name: String) -> Result<()> {
+        let command = match name.as_str() {
+            "cut" => InputCommand::Cut,
+            "copy" => InputCommand::Copy,
+            "paste" => InputCommand::Paste,
+            "selectAll" => InputCommand::SelectAll,
+            "undo" => InputCommand::Undo,
+            "redo" => InputCommand::Redo,
+            _ => return Err(Error::from_reason(format!("Unknown input command: {name}"))),
+        };
+        self.apply_input_operation(id, InputOperation::Command(command))
+    }
+}
+
+impl GpuixRenderer {
+    fn apply_input_operation(&self, id: f64, operation: InputOperation) -> Result<()> {
+        let id = index(id, "id")? as u64;
+        self.with_native_view(move |view, window, cx| {
+            let is_input = view.tree.lock().map_err(|_| "Native tree lock poisoned".to_string())?
+                .elements.get(&id).is_some_and(|element| matches!(element.element_type.as_str(), "input" | "textarea"));
+            if !is_input { return Err(format!("Native input {id} does not exist")); }
+            view.custom_registry.input_operation(id, operation, window, cx)
+        })?.map_err(Error::from_reason)
+    }
+}
