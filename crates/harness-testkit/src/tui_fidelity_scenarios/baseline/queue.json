{
  "schema_version": "tui-fidelity-scenario-v2",
  "id": "baseline-queue",
  "adapters": ["grok", "harness"],
  "viewport": {"cols": 80, "rows": 24},
  "actions": [{"paste": {"at_tick": 1, "text": "first queued"}}, {"timed_key": {"at_tick": 2, "key": {"code": "enter", "modifiers": {"shift": false, "alt": false, "ctrl": false, "meta": false}}}}, {"paste": {"at_tick": 3, "text": "second queued"}}, {"timed_key": {"at_tick": 4, "key": {"code": "enter", "modifiers": {"shift": false, "alt": false, "ctrl": false, "meta": false}}}}, {"terminal_reply": {"at_tick": 5, "query": "device_attributes", "response": "\u001b[?1;2c"}}],
  "checkpoints": [
    {"name": "rest", "at_tick": 6, "frame": {"capture_id": "baseline-queue-rest", "viewport": {"cols": 80, "rows": 24}, "state": "rest"}},
    {"name": "mid", "at_tick": 7, "frame": {"capture_id": "baseline-queue-mid", "viewport": {"cols": 80, "rows": 24}, "state": "working"}},
    {"name": "settled", "at_tick": 8, "frame": {"capture_id": "baseline-queue-settled", "viewport": {"cols": 80, "rows": 24}, "state": "settled"}}
  ],
  "substitutions": [],
  "expected_exit": {"code": 0},
  "cleanup": {"restore_workspace": true, "preserve_evidence": true, "temporary_paths": ["tmp/tui-fidelity"]},
  "motion_capture": {"families":["ordered_motion","settle_dwell"],"markers":[{"phase":"startup","boundary":{"before_action":{"ordinal":0}},"observation":"first_changed","repeat_count":1},{"phase":"finish_flash","boundary":{"checkpoint":{"name":"mid"}},"observation":"last_changed_before_stable","repeat_count":1},{"phase":"settle_repeat","boundary":{"checkpoint":{"name":"settled"}},"observation":"stable_repeat","repeat_count":3}]}
}
