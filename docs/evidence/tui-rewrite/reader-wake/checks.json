[
  {
    "name": "build",
    "command": [
      "cargo",
      "build",
      "--release",
      "-p",
      "harness-tui",
      "--all-features",
      "--example",
      "rewrite_probe",
      "--example",
      "resource_probe"
    ],
    "exit_code": 0
  },
  {
    "name": "restoration",
    "command": [
      "python3",
      "scripts/check-tui-restoration.py",
      "--binary",
      "/tmp/tui-reader-wake/resource_probe",
      "--live-binary",
      "/tmp/tui-reader-wake/rewrite_probe",
      "--output",
      "/tmp/tui-reader-wake/green"
    ],
    "exit_code": 0
  },
  {
    "name": "all",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--profile",
      "ci",
      "--workspace",
      "--all-features"
    ],
    "exit_code": 100
  },
  {
    "name": "pty",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--profile",
      "ci",
      "-p",
      "harness-tui",
      "--all-features",
      "--ignore-default-filter",
      "-E",
      "binary(p0_04_pty_recorded) | binary(p1_04_pty_recorded)"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--all-features",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "gates",
    "command": [
      "python3",
      "scripts/check-test-suite-gates.py"
    ],
    "exit_code": 0
  }
]
