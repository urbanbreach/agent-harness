{
  "$schema": "./config.json",

  // Provider and model catalog. Most projects only need one provider and one
  // default model here; keep larger catalogs in provider-catalog.reference.jsonc.
  "provider": {
    "default": {
      "type": "openai_compatible",
      "name": "Local OpenAI-Compatible Provider",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "placeholder-api-key",
        "timeoutMs": 1800000
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoningEffort": "medium" } },
            "high": { "name": "High", "metadata": { "reasoningEffort": "high" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoningEffort": "xhigh" } }
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoningEffort": "medium" } },
            "high": { "name": "High", "metadata": { "reasoningEffort": "high" } }
          }
        }
      }
    }
  },

  // Active default model. Use provider/model, optionally provider/model/variant.
  "model": "default/gpt-5.4-mini",

  // Built-in agents are listed so they are easy to discover and toggle.
  // Set enable:false (or enabled:false) to remove one from the runtime.
  // Add model, prompt, tools, or permission here only when overriding defaults.
  "agent": {
    // Canonical single-operator entrypoint. Specialist/team/model lanes remain
    // explicit escalations from this profile rather than alternate defaults.
    "operator": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "high",
    },
    // Legacy compatibility profiles remain shipped for existing configs and
    // internal routing, but they are hidden from the default operator path.
    "build": {
      "enable": true,
      "hidden": true,
      "model": "default/gpt-5.4-mini",
      "variant": "high",
    },
    // Stable read-only planning lane: Plan may inspect the workspace and write
    // only .agent-harness/plans/<run>.md, then uses plan_exit to ask before
    // returning to the operator path.
    "plan": {
      "enable": true,
      "hidden": true,
      "model": "default/gpt-5.5",
      "variant": "xhigh",
    },
    // Strict autonomous delivery lane for work that should enforce todos,
    // focused delegation, and end-to-end verification without changing runtime
    // scheduler semantics.
    "discipline": {
      "enable": true,
      "hidden": true,
      "model": "default/gpt-5.5",
      "variant": "high",
    },
    "general": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "medium",
    },
    "explore": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "low",
    },
    // Explicit task category routes. These are subagents used by
    // task(category=...) and intentionally deny recursive task delegation by
    // default.
    "visual-engineering": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "high",
    },
    "artistry": {
      "enable": true,
      "model": "default/gpt-5.5",
      "variant": "high",
    },
    "ultrabrain": {
      "enable": true,
      "model": "default/gpt-5.5",
      "variant": "xhigh",
    },
    "deep": {
      "enable": true,
      "model": "default/gpt-5.5",
      "variant": "high",
    },
    "quick": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "low",
    },
    "unspecified-low": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "low",
    },
    "unspecified-high": {
      "enable": true,
      "model": "default/gpt-5.5",
      "variant": "high",
    },
    "writing": {
      "enable": true,
      "model": "default/gpt-5.4-mini",
      "variant": "medium",
    },
    "title": {
      "enable": true,
      "hidden": true,
    },
    "summary": {
      "enable": true,
      "hidden": true,
    },
    "compaction": {
      "enable": true,
      "hidden": true,
    }
  },

  "default_agent": "operator",

  // One scalar applies to all supported tool permissions; switch to an object
  // when a project needs per-tool rules.
  "permission": "ask",

  // Staged Harness-native workflow controls. Workflow state remains
  // coordinator-owned events plus redacted artifact refs; these knobs configure
  // command foundations, doctor checks, and future simulator/signoff policy.
  "runtime": {
    "workflow": {
      "enabled": true,
      "aliases": true,
      "project_artifacts": false,
      "run": {
        "default_lane": "simulated",
        "require_dossier": true,
        "require_evidence": true,
      },
      "closeout": {
        "default_policy": "workflow.closeout.default",
        "require_replay_equivalence": true,
        "allow_audit_only": true,
        // Policy maps default to all built-in workflow.closeout.* ids. Override
        // only when a workflow needs stricter export or live-approval behavior.
        // "policies": {
        //   "workflow.closeout.default": {
        //     "enabled": true,
        //     "version": 1,
        //     "require_evidence": true,
        //     "require_dossier": true,
        //     "require_export_artifact": false,
        //     "allow_live_approval": false
        //   }
        // }
      },
      "interview": {
        "default_profile": "standard",
        "threshold": 0.2,
        "max_rounds": 12,
      },
      "plan_consensus": {
        "max_iterations": 5,
        "deliberate_triggers": ["auth", "security", "migration", "public api", "pii"],
      },
      "work_loop": {
        "max_iterations": 10,
        "require_manual_qa": true,
      },
      "team": {
        "max_members": 8,
        "max_parallel_members": 4,
        "tmux_visualization": false,
        "worktrees": false,
      },
      "goal": {
        "require_final_quality_gate": true,
      },
      "research_loop": {
        "max_iterations": 10,
      },
      "wiki": {
        "enabled": false,
        "root": ".agent-harness/wiki",
        "auto_capture": false,
      },
    },
  },

  // Optional migration adapters for upstream-style local files.
  // Imports are prompts/config only; executable plugin loading remains disabled.
  "compatibility": {
    "required": false,
    "disabled_agents": [],
    "disabled_skills": [],
    "disabled_commands": [],
    "disabled_mcp_servers": [],
    "disabled_hooks": [],
    "disabled_extensions": []
  },

  // Optional MCP servers. Disabled entries stay documented but do not launch.
  "mcp": {
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["cargo-mcp", "serve"],
      "enabled": false
    },
    "exa": {
      "transport": "http",
      "endpoint": "https://mcp.exa.ai/mcp",
      "enabled": false
    },
    "tavily": {
      "transport": "http",
      "endpoint": "https://mcp.tavily.com/mcp",
      "enabled": false
    },
    "context7": {
      "transport": "http",
      "endpoint": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "grep-app": {
      "transport": "http",
      "endpoint": "https://mcp.grep.app",
      "enabled": false
    }
  }
}
