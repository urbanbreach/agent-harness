    "default": {
      "type": "openai_compatible",
      "name": "CLIProxyAPI (OpenAI)",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "sk-zerolimit",
        "timeoutMs": 1800000,
