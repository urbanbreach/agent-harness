    {"name": "read", "family": "read", "keys": []},
    {"name": "down", "keys": ["Down"]},
    {"name": "search", "keys": ["/", "l", "i", "n", "e", "_", "1", "2", "0", "Enter"]},
    {"name": "filter", "keys": ["f", "l", "i", "n", "e", "_", "1", "2", "Enter"]},
    {"name": "select", "keys": ["v", "Down"]},
    {"name": "search-editing", "keys": ["/", "l", "i", "n", "e", "_", "1", "2"]},
    {"name": "filter-editing", "keys": ["f", "l", "i", "n", "e", "_", "1", "2"]},
    {"name": "regex", "keys": ["/", "L", "I", "N", "E", "_", "1", "2", "[", "0", "-", "3", "]", "Enter"]},
    {"name": "scroll", "keys": ["Ctrl-j"]},
    {"name": "reserved-control-d", "keys": ["Ctrl-d"]},
