+    #[gpui::test]
+    fn test_layout_handler_reports_programmatic_scroll_without_wheel(cx: &mut TestAppContext) {
+        let cx = cx.add_empty_window();
+        let state = ListState::new(20, ListAlignment::Bottom, px(10.))
+            .with_uniform_item_height(px(20.));
+        let ranges = Rc::new(RefCell::new(Vec::new()));
+        let reported = ranges.clone();
+        state.set_layout_handler(move |event, _, _| {
+            reported.borrow_mut().push(event.visible_range.clone());
+        });
+        struct TestView(ListState);
+        impl Render for TestView {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                list(self.0.clone(), |_, _, _| div().h(px(20.)).w_full().into_any())
+                    .w_full()
+                    .h_full()
+            }
+        }
+        let mut draw = || {
+            cx.draw(point(px(0.), px(0.)), size(px(100.), px(60.)), |_, cx| {
+                cx.new(|_| TestView(state.clone())).into_any_element()
+            });
+        };
+        draw();
+        assert_eq!(ranges.borrow().last(), Some(&(17..20)));
+        state.scroll_to(ListOffset { item_ix: 2, offset_in_item: px(0.) });
+        draw();
+        assert_eq!(ranges.borrow().last(), Some(&(2..5)));
+        let count = ranges.borrow().len();
+        draw();
+        assert_eq!(ranges.borrow().len(), count);
+        state.set_follow_mode(FollowMode::Tail);
+        state.scroll_to(ListOffset { item_ix: 2, offset_in_item: px(0.) });
+        state.splice(0..20, 2);
+        draw();
+        assert!(!state.is_following_tail(), "remeasurement must not resume following");
+        state.scroll_to(ListOffset { item_ix: 2, offset_in_item: px(0.) });
+        assert!(state.is_following_tail(), "explicit tail navigation resumes following");
+    }
