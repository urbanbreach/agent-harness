{
  "schema_version":"tui-fidelity-scenario-v2",
  "id":"packet2-sustained-stream",
  "adapters":["grok","harness"],
  "viewport":{"cols":120,"rows":40},
  "terminal_type":"xterm-256color",
  "actions":[
    {"type_text":{"at_tick":1,"text":"typed-while-streaming","inter_byte_millis":45}},
    {"wheel":{"at_tick":2,"direction":"down","amount":8,"point":{"col":60,"row":20}}},
    {"wait_for_text":{"at_tick":3,"text":"PACKET2_DISCLOSURE_SENTINEL"}},
    {"click_text":{"at_tick":4,"text":"PACKET2_DISCLOSURE_SENTINEL","offset_col":0}},
    {"wait_for_text":{"at_tick":5,"text":"PACKET2_DISCLOSURE_BODY"}},
    {"click_text":{"at_tick":6,"text":"PACKET2_DISCLOSURE_SENTINEL","offset_col":0}},
    {"resize":{"at_tick":7,"viewport":{"cols":100,"rows":35},"dwell_millis":120}},
    {"resize":{"at_tick":8,"viewport":{"cols":160,"rows":55},"dwell_millis":120}},
    {"resize":{"at_tick":9,"viewport":{"cols":100,"rows":35},"dwell_millis":120}},
    {"resize":{"at_tick":10,"viewport":{"cols":160,"rows":55},"dwell_millis":120}},
    {"resize":{"at_tick":11,"viewport":{"cols":120,"rows":40},"dwell_millis":120}},
    {"timed_key":{"at_tick":12,"key":{"code":{"char":"c"},"modifiers":{"shift":false,"alt":false,"ctrl":true,"meta":false}}}},
    {"wait_for_semantic_state":{"at_tick":13,"state":"prompt_ready"}}
  ],
  "motion_capture":{"families":["streaming_deltas","scroll_flush","resize_debounce","cancellation_ordering","settle_dwell"],"markers":[
    {"phase":"streaming_delta","boundary":{"after_action":{"ordinal":0}},"observation":"each_changed","repeat_count":1},
    {"phase":"scroll_flush","boundary":{"after_action":{"ordinal":1}},"observation":"last_changed_before_stable","repeat_count":1},
    {"phase":"resize_burst","boundary":{"before_action":{"ordinal":6}},"observation":"first_changed","repeat_count":1},
    {"phase":"resize_settled","boundary":{"after_action":{"ordinal":10}},"observation":"last_changed_before_stable","repeat_count":1},
    {"phase":"cancellation","boundary":{"after_action":{"ordinal":11}},"observation":"first_changed","repeat_count":1},
    {"phase":"cancel_recovered","boundary":{"after_action":{"ordinal":12}},"observation":"last_changed_before_stable","repeat_count":1},
    {"phase":"settle_repeat","boundary":{"checkpoint":{"name":"settled"}},"observation":"stable_repeat","repeat_count":3}
  ]},
  "checkpoints":[
    {"name":"rest","at_tick":14,"frame":{"capture_id":"packet2-rest","viewport":{"cols":120,"rows":40},"state":"rest"}},
    {"name":"mid","at_tick":15,"frame":{"capture_id":"packet2-mid","viewport":{"cols":120,"rows":40},"state":"working"}},
    {"name":"settled","at_tick":16,"frame":{"capture_id":"packet2-settled","viewport":{"cols":120,"rows":40},"state":"settled"}}
  ],
  "substitutions":[],
  "expected_exit":{"code":0},
  "cleanup":{"restore_workspace":true,"preserve_evidence":true,"temporary_paths":["tmp/tui-fidelity-packet2"]}
}
