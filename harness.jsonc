{
  "$schema": "./configs/config.json",

  // Provider and model catalog for this workspace.
  "provider": {
    "mistral": {
      "type": "openai_compatible",
      "name": "Mistral",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiMode": "chat_completions",
        "cacheRetention": "none",
        "apiKeyEnv": [
          "MISTRAL_API_KEY"
        ],
        "timeoutMs": 1800000
      },
      "models": {
        "zai-glm-5-3": {
          "name": "GLM 5.3",
          "metadata": {
            "supportsToolCalls": true
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "name": "Low",
              "metadata": {
                "reasoningEffort": "low"
              }
            },
            "high": {
              "name": "High",
              "metadata": {
                "reasoningEffort": "high"
              }
            },
            "max": {
              "name": "Max",
              "metadata": {
                "reasoningEffort": "max"
              }
            }
          }
        }
      }
    },
    "openai-codex": {
      "type": "openai_compatible",
      "name": "OpenAI Codex",
      "options": {
        "authProvider": "codex",
        "baseURL": "https://api.openai.com/v1",
        "apiKeyEnv": ["OPENAI_API_KEY"],
        "timeoutMs": 1800000,
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT 6 Astra",
          "metadata": {
            "family": "gpt-astra",
            "supportsToolCalls": true,
            "supportsReasoningSummaries": true,
          },
          "limit": { "context": 1050000, "input": 288384, "output": 128000 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "variants": {
            "low": {
              "name": "Low",
              "metadata": { "reasoningEffort": "low", "textVerbosity": "low" },
            },
            "medium": {
              "name": "Medium",
              "metadata": { "reasoningEffort": "medium", "textVerbosity": "low" },
            },
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high", "textVerbosity": "low" },
            },
            "xhigh": {
              "name": "XHigh",
              "metadata": { "reasoningEffort": "xhigh", "textVerbosity": "low" },
            },
            "max": {
              "name": "Max",
              "metadata": { "reasoningEffort": "max", "textVerbosity": "low" },
            },
          },
        },
        "gpt-6-sol": {
          "name": "GPT 6 Sol",
          "metadata": { "supportsToolCalls": true, "supportsReasoningSummaries": true },
          "limit": { "context": 1050000, "input": 288384, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoningEffort": "medium" } },
            "high": { "name": "High", "metadata": { "reasoningEffort": "high" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoningEffort": "xhigh" } },
            "max": { "name": "Max", "metadata": { "reasoningEffort": "max" } },
          },
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna",
          "metadata": { "supportsToolCalls": true, "supportsReasoningSummaries": true },
          "limit": { "context": 1050000, "input": 288384, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": { "name": "Medium", "metadata": { "reasoningEffort": "medium" } },
            "high": { "name": "High", "metadata": { "reasoningEffort": "high" } },
            "xhigh": { "name": "XHigh", "metadata": { "reasoningEffort": "xhigh" } },
            "max": { "name": "Max", "metadata": { "reasoningEffort": "max" } },
          },
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "options": { "serviceTier": "priority" },
          "variants": {
            "low": { "name": "Low", "metadata": { "reasoningEffort": "low" } },
            "medium": {
              "name": "Medium",
              "metadata": { "reasoningEffort": "medium" },
            },
            "high": {
              "name": "High",
              "metadata": { "reasoningEffort": "high" },
            },
            "xhigh": {
              "name": "XHigh",
              "metadata": { "reasoningEffort": "xhigh" },
            },
          },
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "limit": {
            "context": 1050000,
            "input": 369384,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "options": { "serviceTier": "priority" },
          "variants": {
            "low": {
              "name": "Low",
              "metadata": { "reasoningEffort": "low" },
            },
            "max": {
              "name": "Max",
              "metadata": { "reasoningEffort": "max" },
            },
          },
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "limit": {
            "context": 1050000,
            "input": 369384,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "options": { "serviceTier": "priority" },
          "variants": {
            "low": {
              "name": "Low",
              "metadata": { "reasoningEffort": "low" },
            },
            "max": {
              "name": "Max",
              "metadata": { "reasoningEffort": "max" },
            },
          },
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": {
            "context": 1050000,
            "input": 369384,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "options": { "serviceTier": "priority" },
          "variants": {
            "low": {
              "name": "Low",
              "metadata": { "reasoningEffort": "low" },
            },
            "max": {
              "name": "Max",
              "metadata": { "reasoningEffort": "max" },
            },
          },
        },
      },
    },
  },

  // Default primary model and smaller model used by internal runtime operations.
  "model": "openai-codex/gpt-6-sol",
  "small_model": "openai-codex/gpt-6-luna",

  // One generic parent plus named subagents for bounded task delegation.
  "agent": {
    "default": {
      "model": "openai-codex/gpt-6-sol",
      "variant": "medium",
    },
    "general": {
      "model": "openai-codex/gpt-6-luna",
      "variant": "max",
    },
    "explore": {
      "model": "openai-codex/gpt-6-luna",
      "variant": "low",
    },
    "librarian": {
      "model": "openai-codex/gpt-6-luna",
      "variant": "low",
    },
  },

  // Default tool permission policy for this workspace.
  "permission": {
    "*": "ask",
    "shell_allowlist": {
      "executables": ["bash", "git", "cargo", "ls", "rg"],
      "cwd_roots": ["."],
    },
  },

  // MCP servers available to configured agents/tools. Disabled entries stay as
  // documented options but do not launch.
  "mcp": {
    "gh_grep": {
      "transport": "http",
      "endpoint": "https://mcp.grep.app",
    },
    "docs-rs": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@nuskey8/docs-rs-mcp@latest"],
    },
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["/home/ubere/.cargo/bin/cargo-mcp", "serve"],
      "enabled": false,
    },
    "playwright": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": false,
    },
    "svelte": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@sveltejs/mcp"],
      "enabled": false,
    },
    "tauri": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": false,
    },
  },
}
