@@ -0,0 +1,204 @@
+use gpui::{ClipboardEntry, ClipboardItem, Decorations, ResizeEdge, WindowAppearance, WindowDecorations};
+use napi::bindgen_prelude::Buffer;
+use napi::{Error, Result, Status};
+use napi_derive::napi;
+
+use crate::renderer::GpuixRenderer;
+
+#[napi(object)]
+pub struct ClipboardImage {
+    pub mime: String,
+    pub data: Buffer,
+}
+
+#[napi(object)]
+pub struct WindowTiling {
+    pub top: bool,
+    pub left: bool,
+    pub right: bool,
+    pub bottom: bool,
+}
+
+#[napi(object)]
+pub struct NativeWindowDecorations {
+    pub kind: String,
+    pub tiling: WindowTiling,
+}
+
+#[napi(object)]
+pub struct NativeWindowControls {
+    pub fullscreen: bool,
+    pub maximize: bool,
+    pub minimize: bool,
+    pub window_menu: bool,
+}
+
+#[napi]
+impl GpuixRenderer {
+    /// Override native chrome appearance, or follow the system.
+    /// GPUI applies this app-wide on macOS; other platforms leave it unchanged.
+    #[napi]
+    pub fn set_window_appearance(&self, appearance: String) -> Result<()> {
+        let appearance = match appearance.as_str() {
+            "light" => Some(WindowAppearance::Light),
+            "dark" => Some(WindowAppearance::Dark),
+            "system" => None,
+            _ => {
+                return Err(Error::new(
+                    Status::InvalidArg,
+                    "Window appearance must be light, dark, or system",
+                ));
+            }
+        };
+        self.with_native_window(move |window, cx| {
+            cx.set_window_appearance(appearance);
+            window.refresh();
+        })
+    }
+
+    /// Set the logical-pixel size used for rem units in this window.
+    #[napi]
+    pub fn set_rem_size(&self, size: f64) -> Result<()> {
+        let size = size as f32;
+        if !size.is_finite() || size <= 0.0 {
+            return Err(Error::new(
+                Status::InvalidArg,
+                "Rem size must be a positive finite logical-pixel value",
+            ));
+        }
+        self.with_native_window(move |window, _cx| {
+            window.set_rem_size(gpui::px(size));
+            window.refresh();
+        })
+    }
+
+    /// Replace the platform clipboard with plain text.
+    #[napi]
+    pub fn write_clipboard_text(&self, text: String) -> Result<()> {
+        self.with_native_window(move |_window, cx| {
+            cx.write_to_clipboard(ClipboardItem::new_string(text));
+        })
+    }
+
+    /// Read the platform clipboard's text using GPUI's clipboard conversion.
+    #[napi]
+    pub fn read_clipboard_text(&self) -> Result<Option<String>> {
+        self.with_native_window(|_window, cx| {
+            cx.read_from_clipboard().and_then(|item| item.text())
+        })
+    }
+
+    /// Return the first clipboard image in its original encoded format.
+    #[napi]
+    pub fn read_clipboard_image(&self) -> Result<Option<ClipboardImage>> {
+        let image = self.with_native_window(|_window, cx| {
+            cx.read_from_clipboard().and_then(|item| {
+                item.into_entries().find_map(|entry| match entry {
+                    ClipboardEntry::Image(image) => Some(image),
+                    _ => None,
+                })
+            })
+        })?;
+        Ok(image.map(|image| ClipboardImage {
+            mime: image.format.mime_type().to_owned(),
+            data: image.bytes.into(),
+        }))
+    }
+
+    /// Query the actual decoration mode and compositor-reported tiled edges.
+    #[napi]
+    pub fn window_decorations(&self) -> Result<NativeWindowDecorations> {
+        self.with_native_window(|window, _cx| {
+            let (kind, tiling) = match window.window_decorations() {
+                Decorations::Server => ("server", gpui::Tiling::default()),
+                Decorations::Client { tiling } => ("client", tiling),
+            };
+            NativeWindowDecorations {
+                kind: kind.to_owned(),
+                tiling: WindowTiling {
+                    top: tiling.top,
+                    left: tiling.left,
+                    right: tiling.right,
+                    bottom: tiling.bottom,
+                },
+            }
+        })
+    }
+
+    /// Request client decorations, or server decorations when disabled.
+    /// The compositor decides the actual mode returned by windowDecorations.
+    #[napi]
+    pub fn request_client_decorations(&self, enabled: bool) -> Result<()> {
+        self.with_native_window(move |window, _cx| {
+            window.request_decorations(if enabled {
+                WindowDecorations::Client
+            } else {
+                WindowDecorations::Server
+            });
+        })
+    }
+
+    /// Begin the platform's interactive move operation.
+    #[napi]
+    pub fn start_window_move(&self) -> Result<()> {
+        self.with_native_window(|window, _cx| window.start_window_move())
+    }
+
+    /// Begin an interactive resize on n, s, e, w, ne, nw, se, or sw.
+    #[napi]
+    pub fn start_window_resize(&self, edge: String) -> Result<()> {
+        let edge = match edge.as_str() {
+            "n" => ResizeEdge::Top,
+            "s" => ResizeEdge::Bottom,
+            "e" => ResizeEdge::Right,
+            "w" => ResizeEdge::Left,
+            "ne" => ResizeEdge::TopRight,
+            "nw" => ResizeEdge::TopLeft,
+            "se" => ResizeEdge::BottomRight,
+            "sw" => ResizeEdge::BottomLeft,
+            _ => {
+                return Err(Error::new(
+                    Status::InvalidArg,
+                    "Resize edge must be n, s, e, w, ne, nw, se, or sw",
+                ));
+            }
+        };
+        self.with_native_window(move |window, _cx| window.start_window_resize(edge))
+    }
+
+    #[napi]
+    pub fn is_window_maximized(&self) -> Result<bool> {
+        self.with_native_window(|window, _cx| window.is_maximized())
+    }
+
+    /// Query the controls supported by the platform for this window.
+    #[napi]
+    pub fn window_controls(&self) -> Result<NativeWindowControls> {
+        self.with_native_window(|window, _cx| {
+            let controls = window.window_controls();
+            NativeWindowControls {
+                fullscreen: controls.fullscreen,
+                maximize: controls.maximize,
+                minimize: controls.minimize,
+                window_menu: controls.window_menu,
+            }
+        })
+    }
+
+    #[napi]
+    pub fn is_window_active(&self) -> Result<bool> {
+        self.with_native_window(|window, _cx| window.is_window_active())
+    }
+
+    /// Query the current appearance, reducing vibrant variants to light/dark.
+    #[napi]
+    pub fn window_appearance(&self) -> Result<String> {
+        self.with_native_window(|window, _cx| {
+            match window.appearance() {
+                WindowAppearance::Light | WindowAppearance::VibrantLight => "light",
+                WindowAppearance::Dark | WindowAppearance::VibrantDark => "dark",
+            }
+            .to_owned()
+        })
+    }
+}
