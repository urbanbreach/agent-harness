+            if events.contains($kind) {
+                let (layout, text, callback) = (layout.clone(), text.clone(), callback.clone());
+                window.on_mouse_event(move |$event: &$ty, phase, _, _| {
+                    if phase != gpui::DispatchPhase::Bubble || !layout.bounds().contains(&$event.position) || !($filter) { return; }
