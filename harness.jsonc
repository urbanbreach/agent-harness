  // Default primary model and smaller model used by hidden/background agents.
  "model": "umans-ai-coding-plan/umans-kimi-k2.7",
  "small_model": "umans-ai-coding-plan/umans-flash",

  // Built-in agents are listed explicitly for discoverability. Use enable:false
  // (or enabled:false) to remove one; add model/prompt/tools only for overrides.
  "agent": {
    "build": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "plan": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "general": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "explore": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-flash",
    },
    "visual-engineering": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "artistry": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "ultrabrain": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "deep": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "quick": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-flash",
    },
    "unspecified-low": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-flash",
    },
    "unspecified-high": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-kimi-k2.7",
    },
    "writing": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-flash",
    },
    "title": {
      "enable": true,
      "model": "umans-ai-coding-plan/umans-flash",
      "hidden": true,
    },
    "summary": {
      "enable": true,
      "hidden": true,
    },
    "compaction": {
      "enable": true,
      "hidden": true,
    },
  },
  "default_agent": "build",

  // Default tool permission policy for this workspace.
  "permission": {
    "*": "ask",
    "shell_allowlist": {
      "executables": ["bash", "git", "cargo", "ls", "rg"],
      "cwd_roots": ["."],
    },
  },

  // MCP servers available to configured agents/tools. Disabled entries stay as
  // documented options but do not launch.
  "mcp": {
    "gh_grep": {
      "transport": "http",
      "endpoint": "https://mcp.grep.app",
    },
    "docs-rs": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@nuskey8/docs-rs-mcp@latest"],
    },
    "cargo-mcp": {
      "transport": "stdio",
      "command": ["/home/ubere/.cargo/bin/cargo-mcp", "serve"],
      "enabled": false,
    },
    "playwright": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": false,
    },
    "svelte": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@sveltejs/mcp"],
      "enabled": false,
    },
    "tauri": {
      "transport": "stdio",
      "command": ["bunx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": false,
    },
  },
}
