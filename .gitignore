/.agent-harness/*
!/.agent-harness/agents/
!/.agent-harness/prompts/
!/.agent-harness/skills/

# Local runtime configuration
/harness.json
/harness.jsonc
/tui.jsonc
crates/harness/harness.json

# Local environment secrets and credentials
.env
*.env

# Local research material and scratch files
inspirations/
logo-drafts/
plans/
receipts/
/ATTEMPT/
/check_home.sh
/src/

