+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn run(value: serde_json::Value) -> Run {
+        serde_json::from_value(value).unwrap()
+    }
+
+    #[test]
+    fn overlapping_utf16_styles_preserve_each_property_and_restore_earlier_runs() {
+        let styles = [
+            run(
+                serde_json::json!({"start": 0, "end": 99, "color": "#ff0000", "italic": true, "fontFamily": "mono", "fontWeight": 700, "underline": {}, "strikethrough": {}}),
+            ),
+            run(
+                serde_json::json!({"start": 2, "end": 4, "color": "#0000ff", "italic": false, "background": "#00ff00"}),
+            ),
+            run(serde_json::json!({"start": 1, "end": 3, "color": "invalid", "fontWeight": 400})),
+            run(serde_json::json!({"start": 3, "end": 1, "color": "#ffffff"})),
+            run(serde_json::json!({"start": 3, "end": 3, "color": "#ffffff"})),
+        ];
+        let font = gpui::font("base");
+        let result = styled_runs("a😀bc", &styles, font.clone(), gpui::Hsla::default());
+        let mut outer = TextRun {
+            len: 1,
+            font: gpui::font("mono"),
+            color: color(Some("#ff0000")).unwrap(),
+            background_color: None,
+            underline: Some(gpui::UnderlineStyle {
+                color: None,
+                thickness: gpui::px(1.0),
+                wavy: false,
+            }),
+            strikethrough: Some(gpui::StrikethroughStyle {
+                color: None,
+                thickness: gpui::px(1.0),
+            }),
+        };
+        outer.font.weight = gpui::FontWeight::BOLD;
+        outer.font.style = gpui::FontStyle::Italic;
+        let mut emoji = outer.clone();
+        emoji.len = 4;
+        emoji.font.weight = gpui::FontWeight::NORMAL;
+        emoji.font.style = gpui::FontStyle::Normal;
+        emoji.color = color(Some("#0000ff")).unwrap();
+        emoji.background_color = color(Some("#00ff00"));
+        let mut middle = emoji.clone();
+        middle.len = 1;
+        middle.font.weight = gpui::FontWeight::BOLD;
+        assert_eq!(result, vec![outer.clone(), emoji, middle, outer]);
+        assert!(styled_runs("", &styles, font, gpui::Hsla::default()).is_empty());
+    }
+
+    #[test]
+    fn cached_styling_tracks_text_runs_and_base_style() {
+        let mut cache = StylingCache::default();
+        let mut styles = Arc::new(vec![run(
+            serde_json::json!({"start": 1, "end": 2, "italic": true}),
+        )]);
+        let mut font = gpui::font("base");
+        let mut base_color = color(Some("#ffffff")).unwrap();
+        assert_eq!(
+            cache
+                .get("ab", &styles, font.clone(), base_color)
+                .iter()
+                .map(|run| run.len)
+                .collect::<Vec<_>>(),
+            vec![1, 1]
+        );
+        assert_eq!(
+            cache
+                .get("a😀", &styles, font.clone(), base_color)
+                .iter()
+                .map(|run| run.len)
+                .sum::<usize>(),
+            5
+        );
+        styles = Arc::new(Vec::new());
+        assert_eq!(cache.get("a😀", &styles, font.clone(), base_color).len(), 1);
+        font.family = "changed".into();
+        assert_eq!(
+            cache.get("a😀", &styles, font.clone(), base_color)[0]
+                .font
+                .family,
+            font.family
+        );
+        base_color = color(Some("#ff0000")).unwrap();
+        assert_eq!(
+            cache.get("a😀", &styles, font.clone(), base_color)[0].color,
+            base_color
+        );
+        assert_eq!(cache.get("a😀", &styles, font, base_color)[0].len, 5);
+    }
+}
