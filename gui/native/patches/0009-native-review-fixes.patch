+#[cfg(all(test, feature = "test-support"))]
+mod native_interaction_tests {
+    use super::*;
+    use crate::custom_elements::input::InputOperation;
+    use parking_lot::Mutex as EventMutex;
+
+    fn mount<'a>(
+        cx: &'a mut gpui::TestAppContext,
+        tree: Arc<Mutex<RetainedTree>>,
+        events: Arc<EventMutex<Vec<EventPayload>>>,
+    ) -> (gpui::Entity<GpuixView>, &'a mut gpui::VisualTestContext) {
+        let callback: EventCallback = Arc::new(move |event| events.lock().push(event));
+        let (view, cx) = cx.add_window_view(move |_, _| {
+            GpuixView::new(tree, Some(callback), String::new(), SharedSelection::default())
+        });
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        (view, cx)
+    }
+
+    fn rich_text_tree() -> RetainedTree {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "div".to_string());
+        tree.create_element(2, "rich-text".to_string());
+        tree.set_style(1, Arc::new(serde_json::from_value(serde_json::json!({
+            "width": 240, "height": 80, "position": "relative",
+        })).unwrap()));
+        tree.set_style(2, Arc::new(serde_json::from_value(serde_json::json!({
+            "width": 240, "height": 40, "fontSize": 20,
+        })).unwrap()));
+        tree.set_custom_prop(2, "text".to_string(), serde_json::json!("MMMMMMMM"));
+        tree.append_child(1, 2);
+        tree.set_root(1);
+        tree
+    }
+
+    #[gpui::test]
+    fn focused_rich_text_delivers_enter_to_its_key_down_callback(cx: &mut gpui::TestAppContext) {
+        let mut tree = rich_text_tree();
+        tree.set_custom_prop(2, "tabIndex".to_string(), serde_json::json!(0));
+        tree.set_custom_prop(2, "autoFocus".to_string(), serde_json::json!(true));
+        tree.set_event_listener(2, "keyDown".to_string(), true);
+        let events = Arc::new(EventMutex::new(Vec::new()));
+        let (view, cx) = mount(cx, Arc::new(Mutex::new(tree)), events.clone());
+        cx.update(|window, cx| {
+            assert_eq!(view.read(cx).focused_element_id(window), Some(2));
+        });
+
+        cx.simulate_keystrokes("enter");
+
+        let events = events.lock();
+        let keys: Vec<_> = events.iter()
+            .filter(|event| event.event_type == "keyDown")
+            .map(|event| (event.element_id, event.key.as_deref()))
+            .collect();
+        assert_eq!(keys, vec![(2.0, Some("enter"))]);
+    }
+
+    #[gpui::test]
