    },
    {
      "wheel": {
        "at_tick": 23,
        "direction": "down",
        "amount": 1,
        "point": {"col": 20, "row": 5}
      }
    },
    {"resize": {"at_tick": 24, "viewport": {"cols": 100, "rows": 30}}},
