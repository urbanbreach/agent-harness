# Test evidence and probe directories created by integration/e2e tests
artifacts/
.harness-*-probe*/
.harness-foreign-probe*/

# Project-authored configuration and local runtime state. Older builds wrote
# runtime state into .agent-harness/ wherever they ran, including crate dirs.
.harness/
.agent-harness/

# Local runtime configuration
/harness.json
/harness.jsonc
/tui.jsonc
crates/harness/harness.json

# Local environment secrets and credentials
.env
*.env

# Local research material and scratch files
inspirations/
logo-drafts/
plans/
receipts/
/ATTEMPT/
/check_home.sh
/src/

# Local tool and editor state
.cate/
.gnhf/
.impeccable/
.omo/
.omx/
.ruff_cache/
.senpi/
.codex/*
!.codex/agents/
