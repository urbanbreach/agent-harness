    {"name": "end", "keys": ["End"]},
    {"name": "long-wrap", "keys": [], "line_suffix": "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron"},
    {"name": "long-select", "keys": ["v", "Down"], "line_suffix": "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron"},
    {"name": "wrap", "keys": ["w"], "line_suffix": "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron"}
  ]
