index 0000000..34fd4f0
--- /dev/null
+++ w/packages/native/src/custom_elements/rich_text.rs
@@ -0,0 +1,102 @@
+use gpui::{prelude::*, SharedString, TextRun};
+use serde::Deserialize;
+use super::{CustomElement, CustomElementFactory, CustomRenderContext};
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct Run {
+    pub(super) start: usize,
+    pub(super) end: usize,
+    pub(super) color: Option<String>,
+    pub(super) font_family: Option<String>,
+    pub(super) font_weight: Option<crate::style::FontWeightValue>,
+    pub(super) italic: Option<bool>,
+    pub(super) underline: Option<Decoration>,
+    pub(super) strikethrough: Option<Decoration>,
+    pub(super) background: Option<String>,
+    pub(super) wash: Option<Wash>,
+}
+#[derive(Clone, Deserialize)]
+pub(super) struct Decoration { pub(super) color: Option<String>, pub(super) thickness: Option<f32>, pub(super) wavy: Option<bool> }
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct Wash { pub(super) color: String, pub(super) radius: Option<f32>, pub(super) pad_x: Option<f32>, pub(super) inset_y: Option<f32> }
+
+pub struct RichTextFactory;
+impl CustomElementFactory for RichTextFactory {
+    fn element_type(&self) -> &str { "rich-text" }
+    fn create(&self, _: u64) -> Box<dyn CustomElement> { Box::<RichText>::default() }
+}
+#[derive(Default)]
+struct RichText { text: SharedString, runs: Vec<Run> }
+
+// A UTF-16 offset within a surrogate pair resolves to that scalar's beginning.
+pub(super) fn byte_offset(text: &str, offset: usize) -> usize {
+    let mut units = 0;
+    for (byte, ch) in text.char_indices() {
+        if units + ch.len_utf16() > offset { return byte; }
+        units += ch.len_utf16();
+    }
+    text.len()
+}
+pub(super) fn color(value: Option<&str>) -> Option<gpui::Hsla> {
+    value.and_then(crate::color::parse_color_rgba).map(Into::into)
+}
+pub(super) fn styled_runs(text: &str, styles: &[Run], base_font: gpui::Font, base_color: gpui::Hsla) -> Vec<TextRun> {
+    let ranges: Vec<_> = styles.iter().map(|run| (byte_offset(text, run.start)..byte_offset(text, run.end), run)).collect();
+    let mut boundaries = vec![0, text.len()];
+    for (range, _) in &ranges { boundaries.extend([range.start, range.end]); }
+    boundaries.sort_unstable();
+    boundaries.dedup();
+    boundaries.windows(2).filter(|pair| pair[0] < pair[1]).map(|pair| {
+        let mut result = TextRun { len: pair[1] - pair[0], font: base_font.clone(), color: base_color, background_color: None, underline: None, strikethrough: None };
+        for (range, run) in &ranges {
+            if range.start > pair[0] || range.end < pair[1] { continue; }
+            if let Some(value) = color(run.color.as_deref()) { result.color = value; }
+            if let Some(family) = &run.font_family { result.font.family = family.clone().into(); }
+            if let Some(weight) = &run.font_weight { result.font.weight = crate::renderer::parse_font_weight(weight); }
+            if let Some(italic) = run.italic { result.font.style = if italic { gpui::FontStyle::Italic } else { gpui::FontStyle::Normal }; }
+            if let Some(decoration) = &run.underline { result.underline = Some(gpui::UnderlineStyle { color: color(decoration.color.as_deref()), thickness: gpui::px(decoration.thickness.unwrap_or(1.0)), wavy: decoration.wavy.unwrap_or(false) }); }
+            if let Some(decoration) = &run.strikethrough { result.strikethrough = Some(gpui::StrikethroughStyle { color: color(decoration.color.as_deref()), thickness: gpui::px(decoration.thickness.unwrap_or(1.0)) }); }
+            if let Some(value) = color(run.background.as_deref()) { result.background_color = Some(value); }
+        }
+        result
+    }).collect()
+}
+impl CustomElement for RichText {
+    fn render(&mut self, ctx: CustomRenderContext, _window: &mut gpui::Window, _: &mut gpui::Context<crate::renderer::GpuixView>) -> gpui::AnyElement {
+        let base_font = ctx.font.clone();
+        let base_color = ctx.color;
+        let runs = styled_runs(&self.text, &self.runs, base_font, base_color);
+        let washes: Vec<_> = self.runs.iter().filter_map(|run| run.wash.clone().map(|wash| (byte_offset(&self.text, run.start)..byte_offset(&self.text, run.end), wash))).collect();
+        let mut text = crate::text::SelectableText::new(ctx.id, 0, self.text.clone().into(), Some(runs), ctx.selection.clone(), ctx.selection_wash);
+        text.selectable = ctx.selectable;
+        text.highlight = ctx.highlight_set.clone().map(crate::text::HighlightSource::Native);
+        text.pointer_events = Some((ctx.event_callback.clone(), ctx.events.clone()));
+        text.extra_wash = Some(Box::new(move |layout, window| {
+            for (range, wash) in &washes {
+                if let Some(color) = color(Some(&wash.color)) {
+                    for rect in crate::text::range_rects(layout, range, wash.pad_x.unwrap_or(2.0), wash.inset_y.unwrap_or(2.0)) {
+                        window.paint_quad(gpui::quad(rect, gpui::px(wash.radius.unwrap_or(3.0)), color, gpui::px(0.0), gpui::transparent_black(), gpui::BorderStyle::default()));
+                    }
+                }
+            }
+        }));
+        let container = gpui::div().id(SharedString::from(format!("rich-text-{}", ctx.id)));
+        // Pointer events are hit-tested against StyledText rather than the outer box.
+        let mut surface_ctx = ctx;
+        let events = surface_ctx.events.iter().filter(|event| !matches!(event.as_str(), "click" | "mouseDown" | "mouseMove")).cloned().collect();
+        surface_ctx.events = &events;
+        super::custom_surface(container, &surface_ctx).child(crate::text::selectable_text(text)).into_any_element()
+    }
+    fn set_prop(&mut self, key: &str, value: serde_json::Value) {
+        match key {
+            "text" => self.text = value.as_str().unwrap_or_default().into(),
+            "runs" => self.runs = serde_json::from_value(value).unwrap_or_default(),
+            _ => {}
+        }
+    }
+    fn supported_props(&self) -> &'static [&'static str] { &["text", "runs"] }
+    fn supported_events(&self) -> &'static [&'static str] { &["click", "mouseDown", "mouseMove", "mouseEnter", "mouseLeave", "fileDrop"] }
+    fn destroy(&mut self) {}
+}
