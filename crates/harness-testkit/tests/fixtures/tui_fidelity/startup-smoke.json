      "wait_for_semantic_state": {"at_tick": 25, "state": "prompt_ready"}
    },
    {
      "terminal_reply": {
        "at_tick": 26,
        "query": "device_attributes",
        "response": "\u001b[?1;2c"
      }
    }
  ],
  "checkpoints": [
    {
      "name": "rest",
      "at_tick": 27,
      "frame": {
        "capture_id": "startup-rest",
        "viewport": {"cols": 100, "rows": 30},
